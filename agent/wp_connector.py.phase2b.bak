        return res

    # 11. Check for Business Management Category Questions
    is_bm_query = ("business management" in normalized_q or "business administration" in normalized_q or ("business" in normalized_q and any(k in normalized_q for k in ["courses", "qualifications", "diplomas", "offer", "what", "which", "all"]))) and not any(k in normalized_q for k in ["business law", "video", "cpd video", "marketing"])
    has_bm_level = bool(re.search(r'\blevel\s*[3-7]\b|\bl[3-7]\b', normalized_q))
    if is_bm_query and not has_bm_level:
        res = (
            "Explore Business Management Qualifications (Direct from Website Official Landing Page):\n"
            "Inspire London College offers 12 accredited Ofqual-regulated qualifications in Business Management across Levels 3 to 7 awarded by OTHM Qualifications and Qualifi:\n"
            "• Level 3: Qualifi Level 3 Diploma in Business Management & OTHM Level 3 Diploma in Business Management (Initial deposit: £200, £46.25/month for 8 months)\n"
            "• Level 4: Qualifi Level 4 Diploma in Business Management (Initial deposit: £250, £53.75/month for 8 months)\n"
            "• Level 5: Qualifi Level 5 Diploma in Business Management (Initial deposit: £300, £62.50/month) & OTHM/Qualifi Level 5 Extended Diploma in Business Management (Initial deposit: £350, £130.25/month)\n"
            "• Level 6: OTHM Level 6 Diploma in Business Management & Qualifi Level 6 Diploma in Business Administration (Initial deposit: £350, £63.25/month)\n"
            "• Level 7: OTHM Level 7 Diploma in Strategic Management & Leadership & Qualifi Level 7 Diploma in Strategic Management and Leadership (Initial deposit: £400, £70.50/month for 8 months; discounted full fee £899)\n\n"
            "Delivery & Assessment Method:\n"
