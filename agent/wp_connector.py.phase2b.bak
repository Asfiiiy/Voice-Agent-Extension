    # 13. Check for Health & Social Care Category Questions
    is_hsc_query = ("health and social care" in normalized_q or "health & social care" in normalized_q or "social care" in normalized_q or "care course" in normalized_q or "healthcare" in normalized_q) and not any(k in normalized_q for k in ["video", "cpd video", "safety", "early years", "childcare", "child care"])
    has_hsc_level = bool(re.search(r'\blevel\s*[2-7]\b|\bl[2-7]\b', normalized_q))
    if is_hsc_query and not has_hsc_level and any(k in normalized_q for k in ["courses", "qualifications", "diplomas", "what", "which", "all", "offer", "list", "options"]):
        res = (
            "Explore Health and Social Care Qualifications (Direct from Website Official Landing Page):\n"
            "Inspire London College offers accredited Ofqual-regulated qualifications in Health and Social Care from Level 2 to Level 7 awarded by Qualifi, OTHM, NOCN, and iCQ:\n"
            "• Level 2: Qualifi Level 2 Diploma in Care (Initial deposit: £150, £34.62/month for 8 months) and Adult Social Care Certificates.\n"
            "• Level 3: Qualifi Level 3 Diploma in Health and Social Care (Strictly requires age 18+; deposit £75/£200), OTHM Level 3 Foundation Diploma in Health and Social Care (Age 16+), and NOCN/iCQ Level 3 Diploma in Adult Care.\n"
            "• Level 4: Qualifi Level 4 Diploma in Health and Social Care & iCQ Level 4 Diploma in Adult Care (Initial deposit: £250).\n"
            "• Level 5: Qualifi Level 5 Diploma, OTHM Level 5 Extended Diploma, and NOCN/iCQ Level 5 Diploma in Leadership & Management for Adult Care (Deposit £300 to £350).\n"
            "• Level 6: OTHM Level 6 Diploma in Health and Social Care Management (Initial deposit: £350).\n"
            "• Level 7: Qualifi & OTHM Level 7 Diploma in Health and Social Care Management (Postgraduate Master's Level 7; Initial deposit: £400, £70.50/month for 8 months; discounted full fee £899).\n\n"
            "Key Information:\n"
            "• 100% online flexible distance learning, assessed by written assignments (no exams).\n"
            "• Awarding bodies: Qualifi, OTHM, NOCN, and iCQ (all Ofqual regulated)."
        )
        _cache[normalized_q] = {"timestamp": now, "result": res}
        return res

    # 14. Check for Teaching and Assessment (Assessor CAVA & IQA) Questions
    is_assessor_query = any(k in normalized_q for k in ["assessor", "cava", "iqa", "internal quality assurance", "assessing vocational achievement", "teaching and assessment"])
    if is_assessor_query:
        res = (
            "Explore Teaching and Assessment Qualifications (Direct from Website Official Landing Page):\n"
            "Inspire London College offers 9 accredited Ofqual-regulated Assessor and Internal Quality Assurance (IQA) qualifications:\n"
            "• Assessor Qualifications (CAVA):\n"
            "  - Level 3 Certificate in Assessing Vocational Achievement (CAVA) — available under Qualifi, Focus Awards, NOCN, and iCQ.\n"
            "  - Initial Deposit: £150 to £200 (flexible monthly installments).\n"
            "  - Qualification for assessing learners in both classroom and work environments.\n"
            "• Internal Quality Assurance (IQA) Qualifications:\n"
            "  - Level 4 Award in the Internal Quality Assurance of Assessment Processes and Practice (Qualifi & OTHM).\n"
            "  - Level 4 Certificate in Leading the Internal Quality Assurance of Assessment Processes and Practice (NOCN & OTHM).\n"
            "  - Initial Deposit: £200 to £250 (flexible monthly installments).\n\n"
            "Study Mode & Assessment:\n"
            "• 100% online flexible distance learning with dedicated tutor feedback.\n"
            "• Assessment: Portfolio of evidence, assignments, and practical assessment evaluation (no written exams)."
        )
        _cache[normalized_q] = {"timestamp": now, "result": res}
        return res

    # 15. Check for Education & Training / Teacher Training (AET, CET, DET) Questions
    is_teacher_query = any(k in normalized_q for k in ["education and training", "teacher training", "teaching course", "teaching qualification", "aet", "det", "cet", "award in education", "diploma in education"])
    has_teacher_level = bool(re.search(r'\blevel\s*[3-7]\b|\bl[3-7]\b', normalized_q))
    if is_teacher_query and not has_teacher_level:
        res = (
            "Explore Education and Training Qualifications (Direct from Website Official Landing Page):\n"
            "Inspire London College offers 9 accredited Ofqual-regulated teacher training qualifications:\n"
            "1. Level 3 Award in Education and Training (AET - formerly PTLLS):\n"
            "   - Awarding bodies: Qualifi, Focus Awards, NOCN, and iCQ.\n"
            "   - Fees & Plans: Regular fee £330; 2-month plan £248 (£128 initial deposit, £60/month).\n"
            "   - Duration: 1 to 3 months self-paced online.\n"
            "2. Qualifi Level 4 Certificate in Education and Training (CET - formerly CTLLS):\n"
            "   - Intermediate teacher training qualification.\n"
            "3. Qualifi Level 5 Diploma in Education and Training (DET - formerly DTLLS):\n"
            "   - Full teaching qualification leading to QTLS status.\n"
            "   - Initial deposit: £250 (£53.75/month for 8 months).\n"
            "4. Qualifi Level 5 Extended Diploma in Education and Training Management (Initial deposit: £350).\n"
            "5. Qualifi Level 7 Diploma in Educational Management and Leadership (Initial deposit: £400, £70.50/month for 8 months).\n\n"
            "Delivery & Assessment Method:\n"
            "• 100% online self-paced distance learning, assessed through written assignments and micro-teach session."
        )
        _cache[normalized_q] = {"timestamp": now, "result": res}
        return res

    # 16. Check for Information Technology (IT) Category Questions
    is_it_query = ("information technology" in normalized_q or normalized_q == "it" or "it course" in normalized_q or "it qualification" in normalized_q or "computing" in normalized_q) and not any(k in normalized_q for k in ["cyber", "video", "cpd video"])
    if is_it_query:
        res = (
            "Explore Information Technology Qualifications (Direct from Website Official Landing Page):\n"
            "Inspire London College offers accredited Ofqual-regulated qualifications in Information Technology and Computing:\n"
            "• OTHM Level 3 Foundation Diploma in Information Technology:\n"
            "  - Awarding Body: OTHM Qualifications (Regulated by Ofqual, UK)\n"
            "  - Initial Deposit: £200 (followed by flexible monthly installments)\n"
            "  - Structure: 6 mandatory units (Computer Systems, Coding and Website Development, Networks, Mobile Communications, Cyber Security, Social Media for Business).\n"
            "  - Duration: 6 to 12 months, 100% online self-paced distance learning.\n"
            "  - Assessment: 100% written assignments/reports (no exams).\n"
            "• Specialized Cyber Security Suite: We also offer 5 accredited Qualifi qualifications in Cyber Security from Level 2 to Level 5 (deposits from £150 to £350)."
        )
        _cache[normalized_q] = {"timestamp": now, "result": res}
        return res

    # 17. Smart Query Expansion (e.g. "IT" -> "Information Technology")
    expanded_search = expand_query(normalized_q)

    # 4. Check if corporate training, policy, or institutional page
    page_keywords = ["corporate", "staff training", "workforce", "policy", "refund", "terms", "about", "contact", "progression", "affiliate", "cancel"]
    is_page_query = any(k in normalized_q for k in page_keywords) and not any(k in normalized_q for k in ["diploma", "module", "unit", "credit", "fee", "dates", "requirement", "level", "course", "qualification"])

    chunks = []

    if is_page_query:
        # Search Database Pages first (fast & reliable)
        db_pages = await asyncio.to_thread(search_db_pages, expanded_search)
        if db_pages:
            chunks.append("Official Website Pages & Corporate Information:")
            for p in db_pages[:2]:
                chunks.append(f"• {p['title']}: {p['content']}")
        else:
            # Fallback to REST API
            pages = await search_wp_pages(expanded_search)
            if pages:
                chunks.append("Official Website Pages & Policies:")
                for p in pages[:2]:
                    chunks.append(f"• {p['title']}: {p['content']}")
    else:
        # 5. Search Database Courses with Exact Modules, Duration, & Fees
        courses = await asyncio.to_thread(search_db_courses, expanded_search)
        if courses:
            chunks.append("Live Course & Qualification Catalog (Direct from College Database):")
            is_plural = any(w in normalized_q for w in ["courses", "qualifications", "diplomas", "what", "which", "all", "list", "options", "offer", "any"])
            display_courses = courses[:4] if is_plural else courses[:1]
            for c in display_courses:
                if "Notice:" in c['name']:
                    chunks.append(f"• {c['name']}:\n  {c['requirements']}")
                    continue

                entry = [f"• Qualification: {c['name']}"]
                if c.get('accreditation'):
                    entry.append(f"  - Awarding Body: {c['accreditation']}")
                if c.get('price') and c['price'] != "N/A":
                    entry.append(f"  - Tuition Fee & Payment: {c['price']}")

                # Include all Installment Plans
                if c.get("payment_plans"):
                    entry.append("  - Official Installment & Payment Plans:\n    • " + "\n    • ".join(c["payment_plans"]))
                
                # Include Course Duration
                if c.get("duration") and c['duration'] != "N/A":
                    entry.append(f"  - Course Duration: {c['duration']}")
                
                # Include EXACT MODULES if available
                if c.get("modules"):
                    entry.append(f"  - Official Course Modules / Units: {', '.join(c['modules'])}")

                # Include Certificate & Hard Copy details
                if c.get("certificate"):
                    entry.append(f"  - Certificate & Costs: {c['certificate']}")

                # Suitable For / Target Audience
                if c.get("suitable_for"):
                    entry.append(f"  - Suitable For: {c['suitable_for']}")

                # Entry Requirements
                if c.get("requirements"):
                    entry.append(f"  - Entry Requirements: {c['requirements']}")

                # Accreditation & Regulated Status
                if c.get("accreditation"):
                    entry.append(f"  - Accreditation: {c['accreditation']}")
                
                # Assessment
                if c.get("assessment"):
                    entry.append(f"  - Assessment: {c['assessment']}")
                
                if c.get("dates"):
                    entry.append(f"  - Upcoming London Practical Dates: {', '.join(c['dates'])}")
                
                if c.get("overview") and not c.get("modules"):
                    entry.append(f"  - Overview: {c['overview']}")
                
                # Check if other awarding bodies offer the same subject
                other_bodies = []
                for other_c in courses[1:]:
                    for ab in ['Focus Awards', 'Qualifi', 'OTHM', 'iCQ', 'NOCN', 'ATHE']:
                        if ab.lower() in other_c['name'].lower() and ab.lower() not in c['name'].lower():
                            if ab not in other_bodies:
                                other_bodies.append(ab)
                if other_bodies:
                    entry.append(f"  - Also Available Under Awarding Bodies: {', '.join(other_bodies)} (Inspire London College also offers this course accredited by {', '.join(other_bodies)}).")
                
                chunks.append("\n".join(entry))

        else:
            # Check DB Pages before giving up
            db_pages = await asyncio.to_thread(search_db_pages, expanded_search)
            if db_pages:
                chunks.append("Official Website Pages & Corporate Information:")
                for p in db_pages[:2]:
                    chunks.append(f"• {p['title']}: {p['content']}")

    if not chunks:
        # Check for intelligent related recommendations for non-offered subjects
        alt_mappings = [
            (["doctor", "mbbs", "medicine", "nursing", "nurse", "paramedic", "clinical", "hospital", "dentist", "dentistry", "pharmacist"],
             "Notice: Inspire London College does not offer a clinical degree in Medicine, MBBS, or Nursing. "
             "However, we offer related accredited healthcare alternatives: "
             "1. Level 3 Certificate in Phlebotomy (includes London live practical training on Saturdays for £80/£270). "
             "2. Qualifi and OTHM Level 3, 4, and 5 Diplomas in Health and Social Care. "
             "3. CPD healthcare courses including The Care Certificate and Infection Control."),
            (["acca", "cima", "chartered accountancy", "chartered accountant"],
             "Notice: Inspire London College does not offer ACCA or CIMA certifications. "
             "However, we offer Ofqual-regulated alternatives in Finance: "
             "1. OTHM Level 3 Foundation Diploma in Accountancy. "
             "2. OTHM Level 5 Extended Diploma in Accounting and Business. "
             "3. OTHM Level 7 Diploma in Accounting and Finance (leading to MBA/MSc university top-ups)."),
            (["law", "llb", "barrister", "solicitor"],
             "Notice: Inspire London College does not offer a qualifying law degree (LLB). "
             "However, we offer the OTHM Level 7 Diploma in International Business Law."),
            (["pgce", "qts", "school teacher"],
             "Notice: Inspire London College does not offer a university PGCE or direct QTS. "
             "However, we offer full Ofqual-regulated teacher training qualifications: "
             "1. Focus Awards & Qualifi Level 3 Award in Education and Training (AET - RQF). "
             "2. Level 4 Certificate in Education and Training (CET). "
             "3. Level 5 Diploma in Education and Training (DET)."),
            (["plumbing", "electrician", "trade", "carpentry", "mechanic", "welding"],
             "Notice: Inspire London College does not offer trade apprenticeships in plumbing or electrical work. "
             "However, we offer: "
             "1. Level 1 Health and Safety in a Construction Environment (CSCS Green Card). "
             "2. Certificate in Construction Cost Estimation and Project Management."),
            (["psychology", "counselling", "therapist"],
             "Notice: Inspire London College does not offer clinical psychology degrees. "
             "However, we offer: "
             "1. Level 3 and Level 5 Health and Social Care with mental health and safeguarding units. "
             "2. CPD courses in Mental Health Awareness, Autism, and Dementia Care.")
        ]

        matched_alt = None
        for keywords, alt_msg in alt_mappings:
            if any(k in normalized_q for k in keywords):
                matched_alt = alt_msg
                break

        if matched_alt:
            result_text = matched_alt
        else:
            result_text = (
                f"Inspire London College does not offer a qualification titled '{query}'. "
                f"However, we offer over 290+ accredited Ofqual qualifications across "
                f"Education & Training (AET/DET), Health & Social Care (Level 3 to 7), Business Management, "
                f"Information Technology, Health & Safety (Level 1, 4, 5, 7), and London Phlebotomy practical training. "
                f"Which of these accredited areas would you like to explore?"
            )
    else:
        result_text = "\n\n".join(chunks)

    # Cache result
    _cache[normalized_q] = {
        "timestamp": now,
        "result": result_text
    }

    return result_text

async def check_student_order_status(email_or_order_number: str) -> str:
    """
    Called when a student asks about their enrollment, order status, or payment.
    """
    clean_query = email_or_order_number.strip()
    if not clean_query:
        return "Please provide your registered email address or 5-digit Order Number to check your enrollment."

    orders = await search_wp_orders(clean_query)
    if not orders:
        return f"No active order or enrollment found matching '{clean_query}'. Please verify your details."

    results = []
    for o in orders:
        msg = (
            f"Order #{o['order_id']} for {o['customer_name']}: "
            f"Course: '{o['courses']}'. "
            f"Current Status: {o['status'].upper()}. "
            f"Order Date: {o['date']}."
        )
        if o['status'].lower() in ["completed", "processing"]:
            msg += " Your enrollment is active and verified."
        results.append(msg)

    return "\n".join(results)

