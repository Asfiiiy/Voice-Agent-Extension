# 10-Minute in-memory cache to prevent redundant lookups
_cache: Dict[str, Dict[str, Any]] = {}
CACHE_TTL_SEC = 600

_mysql_available: Optional[bool] = None
_last_mysql_check: float = 0.0

def _check_mysql_available() -> bool:
    global _mysql_available, _last_mysql_check
    now = time.time()
    if _mysql_available is False and (now - _last_mysql_check) < 180:
        return False
    import socket
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(0.08)
    try:
        s.connect((DB_HOST, 3306))
        s.close()
        _mysql_available = True
        return True
    except Exception:
        _mysql_available = False
        _last_mysql_check = now
        return False


def _clean_html(raw_html: str) -> str:
    """Removes HTML tags, entities, and excessive whitespace."""
    if not raw_html:
        return ""
    text = html.unescape(raw_html)
    text = text.replace('\xa3', '£').replace('\xc2\xa3', '£')
    text = re.sub(r'<[^>]+>', ' ', text)
    text = re.sub(r'\[[^\]]+\]', ' ', text)
    text = re.sub(r'\s+', ' ', text).strip()
    return text

def _parse_modules_table(raw_html: str) -> List[str]:
    """Extracts exact unit titles and credits from WordPress course_outline HTML table."""
    if not raw_html:
        return []
    rows = re.findall(r'<tr>(.*?)</tr>', raw_html, re.DOTALL | re.IGNORECASE)
    modules = []
    for r in rows:
        cells = re.findall(r'<td[^>]*>(.*?)</td>', r, re.DOTALL | re.IGNORECASE)
        clean_cells = [_clean_html(c) for c in cells if _clean_html(c)]
        if len(clean_cells) >= 2 and not any('unit title' in c.lower() or 'unit ref' in c.lower() for c in clean_cells):
            c0 = clean_cells[0].strip()
            c1 = clean_cells[1].strip()
            # If c0 is a short unit code like 'Unit 1' or 'H/505/0053' and c1 is descriptive title
            if (re.match(r'^(unit\s*\d+|[a-z0-9/_-]+)$', c0, re.I) or len(c0) <= 12) and len(c1) > len(c0):
                title = c1
            else:
                title = c0
            credits = next((c for c in clean_cells[2:] if c.isdigit() and int(c) <= 60), "")
            if credits:
                modules.append(f"{title} ({credits} credits)")
            else:
                modules.append(title)
    return modules


def _parse_payment_options(raw_html: str) -> List[str]:
    """Dynamically parses WordPress payment_options table across all columns (Full fee, 2-month, 3-month, 6-month, 8-month, 10-month, Fast track)."""
    if not raw_html:
        return []
    rows = re.findall(r'<tr>(.*?)</tr>', raw_html, re.DOTALL | re.IGNORECASE)
    if len(rows) < 2:
        return []

    # Parse headers to identify column positions
    headers = [re.sub(r'<[^>]+>', '', c).strip().lower() for c in re.findall(r'<t[dh][^>]*>(.*?)</t[dh]>', rows[0], re.DOTALL | re.IGNORECASE)]
    col_reg = next((i for i, h in enumerate(headers) if 'regular' in h), 1)
    col_disc = next((i for i, h in enumerate(headers) if 'discounted' in h), 2)
    col_pct = next((i for i, h in enumerate(headers) if '%' in h or 'percent' in h), 3)
    col_dep = next((i for i, h in enumerate(headers) if 'initial' in h or 'deposit' in h), 4)
    col_inst = next((i for i, h in enumerate(headers) if 'instalment' in h or 'installment' in h or 'monthly' in h), 5)

    plans = []
    for r in rows[1:]:
        cells = [re.sub(r'<[^>]+>', '', c).strip().replace('\xa3', '£').replace('\xc2\xa3', '£') for c in re.findall(r'<t[dh][^>]*>(.*?)</t[dh]>', r, re.DOTALL | re.IGNORECASE)]
        if not cells or not cells[0]:
            continue
        name = cells[0]
        name_lower = name.lower()

        # Check if row has valid figures (ignore rows where all data cells are dashes)
        non_dash = [c for c in cells[1:] if c and c != '-']
        if not non_dash:
            continue

        reg_fee = cells[col_reg] if len(cells) > col_reg and cells[col_reg] != '-' else ''
        disc_fee = cells[col_disc] if len(cells) > col_disc and cells[col_disc] != '-' else ''
        pct = cells[col_pct] if len(cells) > col_pct and cells[col_pct] != '-' else ''
        deposit = cells[col_dep] if len(cells) > col_dep and cells[col_dep] != '-' else ''
        monthly = cells[col_inst] if len(cells) > col_inst and cells[col_inst] != '-' else ''

        if 'fast track' in name_lower and ('full fee' in name_lower or (not deposit and not monthly)):
            total = disc_fee or reg_fee
            reg_note = f" (Regular fee {reg_fee})" if reg_fee and reg_fee != total else ""
            plans.append(f"Fast Track Full Fee: Total {total}{reg_note}")
        elif 'pay full' in name_lower or 'full fee' in name_lower:
            total = disc_fee or reg_fee
            discount_info = f" ({pct} discount from regular fee {reg_fee})" if (reg_fee and pct) else (f" (Regular fee {reg_fee})" if reg_fee else "")
            plans.append(f"Pay in Full: {total}{discount_info}")
        elif deposit and monthly:
            discount_str = f" ({pct} discount from regular fee {reg_fee})" if (reg_fee and pct) else (f" (discounted from regular fee {reg_fee})" if reg_fee else "")
            discount_info = f", Discounted Total Fee = {disc_fee}{discount_str}" if disc_fee else ""
            plans.append(f"{name}: Initial Deposit = {deposit}, Monthly Installment = {monthly}/month{discount_info}")
        elif monthly and not deposit:
            plans.append(f"{name}: Monthly Installment = {monthly}/month, Total Fee = {disc_fee or reg_fee} (Regular fee {reg_fee})")
        elif deposit and not monthly:
            plans.append(f"{name}: Initial Deposit = {deposit}, Total Fee = {disc_fee or reg_fee} (Regular fee {reg_fee})")
        elif disc_fee or reg_fee:
            total = disc_fee or reg_fee
            reg_note = f" (Regular fee {reg_fee})" if reg_fee and reg_fee != total else ""
            plans.append(f"{name}: Total {total}{reg_note}")

    return plans

def expand_query(query: str) -> str:
    """Smart query cleanup and normalization for voice queries while strictly preserving course level, title, and subject keywords."""
    q = query.strip().lower()
    # Remove institution names
    q = re.sub(r'\b(inspire london college|ukpd academy|uk professional development academy|ukpda|ilc)\b', '', q).strip()
    # Remove noise inquiry words
    q = re.sub(r'\b(modules? of|units? of|syllabus of|curriculum of|fees? of|prices? of|cost of|courses? in|qualifications? in|diplomas? in|training programs? at|programs? at|course duration|time duration|duration of|duration|how long|how many months|can i|do you offer|what is the|tell me about|what are the|certificate fee of|certification fee of|certificate cost of|certification cost of|certification fee|certificate fee|certification cost|certificate cost|certificate of|certification of|requirements? of|entry requirements? of)\b', '', q).strip()
    
    # Expand abbreviations safely using exact word boundaries
    q = re.sub(r'\b(it|i\.t)\b', 'information technology', q)
    q = re.sub(r'\b(hsc|h&sc)\b', 'health and social care', q)
    q = re.sub(r'\b(h&s|h\s*&\s*s)\b', 'health and safety', q)
    q = re.sub(r'\baet\b', 'award in education and training', q)
    q = re.sub(r'\bdet\b', 'diploma in education and training', q)

    # Normalize Focus Awards speech recognition variations
    q = re.sub(r'\bfocus\s+on\s+(?:our\s+)?(level|award|diploma|certificate|course|education|training|\d)', r'focus awards \1', q)
    q = re.sub(r'\bfocus\s+award\b', 'focus awards', q)


    # Intent categories for static pages ONLY if no specific course/level is requested
    if not any(w in q for w in ['level', 'diploma', 'course', 'qualification', 'unit', 'credit', 'fee']):
        if re.search(r'corporate|staff training|workforce|employee training', q):
            return "corporate training"
        if re.search(r'refund|cancel|money back', q):
            return "refund policy"
        if re.search(r'progress|university progression|degree top up', q):
            return "university progression"

    return q

def search_db_pages(search_term: str) -> List[Dict[str, str]]:
    """Direct high-speed database search for published WordPress pages (Corporate Training, Policies, Terms)."""
    if not _check_mysql_available():
        return []
    try:
        conn = pymysql.connect(
            host=DB_HOST,
            user=DB_USER,
            password=DB_PASS,
            database=DB_NAME,
            charset='utf8mb4',
            connect_timeout=3
        )
        with conn.cursor(pymysql.cursors.DictCursor) as cur:
            title_pat = search_term
            if "refund" in search_term or "cancel" in search_term:
                title_pat = "Terms"
            elif "progression" in search_term or "university" in search_term:
                title_pat = "Progression"
            elif "corporate" in search_term:
                title_pat = "Corporate"
            elif "contact" in search_term or "address" in search_term:
                title_pat = "Contact"
            elif "about" in search_term or "accreditation" in search_term:
                title_pat = "About"

            sql = """
                SELECT ID, post_title, post_content
                FROM twh_posts
                WHERE post_type = 'page' AND post_status = 'publish'
                  AND (post_title LIKE %s OR post_name LIKE %s OR post_content LIKE %s)
                ORDER BY ID DESC
                LIMIT 2
            """
            cur.execute(sql, (f"%{title_pat}%", f"%{title_pat.replace(' ', '-')}%", f"%{search_term}%"))
            rows = cur.fetchall()
            pages = []
            for r in rows:
                raw_text = _clean_html(r.get('post_content') or "")
                title = r['post_title']
                if "corporate" in title.lower() or "corporate" in search_term.lower():
                    clean_content = (
                        "Inspire London College Corporate Training empowers businesses and employers worldwide to train staff and upskill their workforce with accredited, flexible online e-learning programs. "
                        "Key Corporate Training Areas Offered: Health & Social Care, Health & Safety, Business Management & Leadership, Accounting & Finance, Education & Training (AET), Information Technology, Construction Management, and Child Psychology. "
                        "Key Benefits for Employers: 24/7 flexible online study suitable for busy staff shift patterns, Ofqual-regulated qualifications and CPD accredited certificates, dedicated learner support, and massive discounts on bulk corporate enrollments. "
                        "Admissions Guidance: Explain these corporate training offerings and proactively ask the caller which specific training area or course they need for their team or organization."
                    )
                else:
                    clean_content = raw_text[:800] + ("..." if len(raw_text) > 800 else "")

                if clean_content:
                    pages.append({
                        "title": title,
                        "content": clean_content
                    })
            conn.close()
            return pages
    except Exception as e:
        print(f"[WP-Connector] DB Pages Search exception: {repr(e)}")
        return []

