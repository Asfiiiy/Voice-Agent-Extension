    # 12. Check for Early Years Education & Childcare Questions
    is_ey_query = "early years" in normalized_q or "childcare" in normalized_q or "child care" in normalized_q or "early learning" in normalized_q
    has_ey_level = bool(re.search(r'\blevel\s*[2-5]\b|\bl[2-5]\b', normalized_q))
    if is_ey_query and not has_ey_level:
        res = (
            "Explore Early Years Education & Childcare Qualifications (Direct from Website Official Landing Page):\n"
            "Inspire London College offers 5 accredited Ofqual-regulated qualifications in Early Years Education & Childcare:\n"
