def build_outbound_instructions(lead_name: str, course_inquired: str) -> str:
    c_lower = (course_inquired or "").lower()
    matched = None
    for key, data in COURSE_KNOWLEDGE.items():
        if key in c_lower:
            matched = data
            break
    if not matched:
        matched = {
            "title": course_inquired or "Professional Qualifications",
            "fee": "The discounted fee is £248 today (regular £330), or start with a £128 deposit and flexible £60 monthly installments.",
            "modules": "Comprehensive practical units assessed through coursework assignments with zero exams.",
            "duration": "6 to 12 months flexible online self-paced study with 1-on-1 UK tutor support.",
            "assessment": "100% online coursework assignments with zero exams.",
            "accreditation": "Ofqual Regulated UK national qualification recognized worldwide.",
        }

    return (
        f"You are Sonia, the charismatic, articulate, empathetic, and highly persuasive Senior Admissions Advisor for Inspire London College (ILC) and UKPD Academy.\n"
        f"You are speaking on a live phone call with a prospective student ({lead_name}) who inquired about our courses on our official website.\n\n"
        f"VERIFIED ILC DATABASE COURSE FACTS (USE WITH 100% ACCURACY):\n"
        f"- Target Qualification: {matched['title']}\n"
        f"- Verified Course Fees: {matched['fee']}\n"
        f"- Verified Units & Syllabus: {matched['modules']}\n"
        f"- Study Duration & Mode: {matched['duration']}\n"
        f"- Assessment Method: {matched['assessment']}\n"
        f"- Official UK Accreditation: {matched['accreditation']}\n\n"
        f"HUMAN-LIKE CONVERSATIONAL INTELLIGENCE (CHATGPT & GEMINI LIVE STANDARD):\n"
        f"You are NOT a scripted robot. You possess deep emotional intelligence, sharp listening comprehension, and consultative sales mastery:\n\n"
        f"1. DYNAMIC CONTEXTUAL COMPREHENSION:\n"
        f"   - Listen to the full meaning, tone, and intent of the caller at every turn.\n"
        f"   - When caller confirms their identity or acknowledges (e.g. 'Yeah', 'Yes', 'Speaking', 'I am here', 'Who is this?', 'Tell me'):\n"
        f"     Respond warmly, introduce yourself and the course inquiry, and check if they have a quick 2 minutes to speak:\n"
        f"     \"This is Sonia calling from Inspire London College regarding your inquiry for the {matched['title']}. Do you have a quick 2 minutes to speak?\"\n"
        f"   - When caller asks what the call is about, agrees to speak, or asks for course details:\n"
        f"     Deliver the value pitch enthusiastically: our {matched['title']} is 100% online coursework with zero exams, accredited by Ofqual, with dedicated 1-on-1 UK tutor support. Then guide them on fees ({matched['fee']}) or installment options.\n"
        f"   - When caller asks about fees or payment options:\n"
        f"     State the verified fee immediately ({matched['fee']}) with complete transparency, and highlight the £128 deposit and interest-free £60/month installment plan.\n"
        f"   - When caller asks about exams or study mode:\n"
        f"     Reassure them with warmth: there are ZERO exams, 100% coursework assignments, and study is self-paced around their existing work schedule.\n"
        f"   - When caller asks about syllabus or modules:\n"
        f"     Explain the exact practical units ({matched['modules']}).\n\n"
        f"2. PROACTIVE SALES CONSULTATION & LIVE TEAM TRANSFER:\n"
        f"   - As an admissions advisor, your goal is to help prospective students enroll and succeed.\n"
        f"   - Once the caller is interested, has their questions answered, or asks how to enroll / register:\n"
        f"     YOU MUST ALWAYS OFFER A LIVE TRANSFER TO OUR SENIOR ADMISSIONS TEAM:\n"
        f"     \"Would you like me to transfer your call to our Senior Admissions team right now so they can help finalize your enrollment and student portal?\"\n"
        f"     If the caller agrees, IMMEDIATELY call transfer_to_support_team(advisor_name='Sarah Jenkins', extension='Ext 101', reason='Finalize student enrollment').\n\n"
        f"3. EMPATHETIC OBJECTION & BUSY CALLER HANDLING:\n"
        f"   - If caller says they are busy, at work, driving, or in a meeting:\n"
        f"     Never push. Graciously offer a callback: \"No problem at all! Would you like me to schedule a callback for later today or tomorrow at your convenient time?\"\n"
        f"     When caller provides their preferred time, IMMEDIATELY call schedule_callback(preferred_time=..., notes=...) and warmly confirm.\n"
        f"   - If caller says they are not interested or wrong number:\n"
        f"     Politely thank them, wish them a great day, and call mark_lead_disposition(disposition='NOT_INTERESTED', reason='Caller not interested').\n\n"
        f"4. SPOKEN CONVERSATIONAL DELIVERY RULES:\n"
        f"   - Keep your turns concise and natural: 1 to 2 warm spoken sentences (under 25 words per turn).\n"
        f"   - Always end with a natural, open guiding question to keep the conversation interactive.\n"
        f"   - Speak with the warmth, confidence, and authority of a human UK university admissions counsellor.\n"
    )

@llm.function_tool(
    name="search_website",
    description="Query the live college website database for real-time course fees, official modules/units, syllabus, entry requirements, upcoming classroom dates, and college policies. Synthesize results conversationally into 1-2 spoken sentences; never recite raw database text or lists."
)
async def search_website(query: str) -> str:
    """Fetches real-time course details, modules, live fees, dates, and website policy pages directly from WordPress."""
    print(f"[*] Tool called: search_website(query='{query}')")
    result = await wp_connector.get_live_site_data(query)
    print(f"[*] search_website output: {result[:180]}...")
    return f"[Database Result - Synthesize in 1-2 natural spoken sentences like a human counselor, do NOT read verbatim]:\n{result}"

@llm.function_tool(
    name="check_student_enrollment",
    description="Check student course enrollment, order status, or payment confirmation using their registered email address or 5-digit Order Number."
)
async def check_student_enrollment(identifier: str) -> str:
    """Looks up authenticated student orders and enrollment records in WooCommerce."""
    print(f"[*] Tool called: check_student_enrollment(identifier='{identifier}')")
    result = await wp_connector.check_student_order_status(identifier)
    print(f"[*] check_student_enrollment output: {result}")
    return result

async def entrypoint(ctx: JobContext):
    # 0. Initialize RAG in background thread
    asyncio.create_task(asyncio.to_thread(rag.init_knowledge_base))

    # 1. Connect to room & subscribe to audio
    await ctx.connect(auto_subscribe=AutoSubscribe.AUDIO_ONLY)

    # 2. Wait for participant to join
    participant = await ctx.wait_for_participant()
    raw_identity = participant.identity or "MicroSIP-Caller"
    caller_phone = raw_identity.replace("sip:", "").split("@")[0] if "sip:" in raw_identity else raw_identity
    caller_name = participant.name or (f"SIP Caller ({caller_phone})" if caller_phone else "MicroSIP Caller")

    # Direction and Lead Metadata Extraction
    direction = "INBOUND"
    course_inquired = "General Qualification"
    lead_name = caller_name

    # Extract metadata from room, job, or participant
    raw_meta = (
        getattr(ctx.room, "metadata", "")
        or getattr(ctx.job, "metadata", "")
        or getattr(participant, "metadata", "")
        or ""
    )
    if raw_meta:
        try:
            meta = json.loads(raw_meta)
            direction = meta.get("direction", "INBOUND").upper()
            if meta.get("leadName"):
                lead_name = meta["leadName"]
                caller_name = lead_name
            if meta.get("courseInquired"):
                course_inquired = meta["courseInquired"]
            if meta.get("phoneNumber"):
                caller_phone = meta["phoneNumber"]
        except Exception as e:
            print(f"[*] Metadata parse notice: {e}")

    if ctx.room.name.startswith("outbound-"):
        direction = "OUTBOUND"

    print(f"User joined room: {ctx.room.name} | Direction: {direction} | Caller: {caller_name} | Course: {course_inquired}")

    # 3. Call orchestrator database record (non-blocking)
    orchestrator = CallOrchestrator(
        room_name=ctx.room.name,
        caller=caller_name,
        phone_number=caller_phone,
        direction=direction,
        course_inquired=course_inquired,
    )
    asyncio.create_task(orchestrator.start_call())

    # Live action tools for agent
    @llm.function_tool(
        name="transfer_to_support_team",
        description="Transfer the caller to an available human customer support advisor from the 5-member admissions team (e.g. Sarah Jenkins on Ext 101, Hamza Ali on Ext 102, or any available advisor)."
    )
    async def transfer_to_support_team(advisor_name: str, extension: str, reason: str) -> str:
        orchestrator.set_disposition("TRANSFERRED", transferred_to=f"{advisor_name} ({extension})", score=95)
        try:
            import httpx
            async with httpx.AsyncClient(timeout=3.0) as client:
                await client.post("http://127.0.0.1:3000/api/team/transfer", json={
                    "callId": orchestrator.call_id,
                    "customerName": caller_name,
                    "phoneNumber": caller_phone,
                    "courseInquired": course_inquired,
                    "leadScore": 95,
                    "preferredMember": advisor_name,
                    "transferSummary": f"Caller {caller_name} wants to finalize enrollment for {course_inquired}. Reason: {reason}."
                })
        except Exception as e:
            print(f"[*] Handoff screen-pop dispatch note: {e}")
        return f"Successfully transferring caller to {advisor_name} on extension {extension} for {reason}."

    @llm.function_tool(
        name="schedule_callback",
        description="Schedule a callback when the caller is busy, in a meeting, or requests a callback."
    )
    async def schedule_callback(preferred_time: str, notes: str) -> str:
        orchestrator.set_disposition("CALLBACK_SCHEDULED", scheduled_callback=preferred_time, score=75)
        try:
            import httpx
            async with httpx.AsyncClient(timeout=3.0) as client:
                # 1. Register in ScheduledCallback table for team members
                await client.post("http://127.0.0.1:3000/api/callbacks", json={
                    "customerName": caller_name,
                    "phoneNumber": caller_phone,
                    "course": course_inquired,
                    "scheduledTime": preferred_time,
                    "agentAssigned": "Sarah Jenkins (Ext 101)",
                    "notes": f"{notes} (Requested by caller during call with Sonia)",
                })
                # 2. Update Lead record status to SCHEDULED_CALL with notes
                await client.patch("http://127.0.0.1:3000/api/leads", json={
                    "phoneNumber": caller_phone,
                    "status": "SCHEDULED_CALL",
                    "disposition": "CALLBACK_SCHEDULED",
                    "scheduledCallback": preferred_time,
                    "humanNotes": f"[AI Sonia Callback Scheduled • {preferred_time}]: {notes}",
                })
        except Exception as e:
            print(f"[*] Notice during schedule_callback API sync: {e}")
        return f"Callback successfully scheduled for {preferred_time}."

    @llm.function_tool(
        name="mark_lead_disposition",
        description="Tag the call disposition when the call concludes (e.g. NOT_INTERESTED, ENROLLED, COLD)."
    )
    async def mark_lead_disposition(disposition: str, reason: str) -> str:
        score = 20 if disposition.upper() == "NOT_INTERESTED" else (98 if disposition.upper() == "ENROLLED" else 50)
        orchestrator.set_disposition(disposition, score=score)
        try:
            import httpx
            async with httpx.AsyncClient(timeout=3.0) as client:
                lead_status = "NOT_CONVERTED" if disposition.upper() == "NOT_INTERESTED" else ("CONVERTED" if disposition.upper() == "ENROLLED" else ("SCHEDULED_CALL" if "CALLBACK" in disposition.upper() else "IN_PROGRESS"))
                await client.patch("http://127.0.0.1:3000/api/leads", json={
                    "phoneNumber": caller_phone,
                    "status": lead_status,
                    "disposition": disposition,
                    "humanNotes": f"[AI Disposition • {disposition}]: {reason}",
                })
        except Exception as e:
            print(f"[*] Notice during mark_lead_disposition API sync: {e}")
        return f"Lead marked as {disposition}: {reason}."

    api_key = os.getenv("GOOGLE_API_KEY")

    # 4. Use optimized Silero VAD model with fast, accurate silence detection
    vad_model = getattr(ctx.proc, "userdata", {}).get("vad") if hasattr(ctx, "proc") else None
    if not vad_model:
        vad_model = silero.VAD.load(min_silence_duration=0.30, min_speech_duration=0.08, activation_threshold=0.55)

    # 5. Initialize Ultra-Fast Streaming STT (Deepgram Nova-3) with balanced 400ms endpointing
    print("[*] Active STT: Deepgram Nova-3 Ultra-Fast Streaming STT")
    stt_instance = deepgram.STT(
        model="nova-3",
        language="en-GB",
        punctuate=True,
        smart_format=True,
        no_delay=True,
        endpointing_ms=300,
        keyterm=[
            "Inspire London College",
            "UKPD Academy",
            "Phlebotomy",
            "Focus Awards",
            "Focus",
            "Qualifi",
            "OTHM",
            "NOCN",
            "iCQ",
            "ATHE",
            "AET",
            "DET",
            "Education and Training",
            "Award in Education and Training",
            "CPD",
            "Level 1",
            "Level 2",
            "Level 3",
            "Level 4",
            "Level 5",
            "Level 7",
            "Health and Safety",
            "CSCS",
            "installment",
            "installments",
            "London",
            "diploma",
            "certificate",
            "OFQUAL",
            "refund",
            "policy",
        ]
    )

    # 6. Initialize LLMs with Groq Primary & Resilient Gemini Fallback (offloaded to thread to prevent 400-850ms SSL context stall)
    groq_api_key = os.getenv("GROQ_API_KEY")
    print(f"[*] GROQ key loaded: {bool(groq_api_key)}")

    def _create_llm_clients():
        g_primary = SafeGeminiLLM(
            api_key=api_key,
            model="gemini-3.5-flash-lite",
            temperature=0.35,
            max_output_tokens=120,
        )
        g_secondary = SafeGeminiLLM(
            api_key=api_key,
            model="gemini-flash-lite-latest",
            temperature=0.35,
            max_output_tokens=120,
        )
        p_groq = None
        if groq_api_key:
            p_groq = groq.LLM(
                model="openai/gpt-oss-20b",
                api_key=groq_api_key,
                temperature=0.35,
                max_completion_tokens=120,
            )
        td_instance = EnglishModel()
        return p_groq, g_primary, g_secondary, td_instance

    primary_groq, gemini_primary, gemini_secondary, turn_detector_instance = await asyncio.to_thread(_create_llm_clients)

    llm_list = []
    if groq_api_key and primary_groq is not None:
        print("[*] Primary LLM in use: Groq (openai/gpt-oss-20b, timeout: 3.0s)")
        llm_list.append(primary_groq)
        adapter_timeout = 3.0
    else:
        print("[*] Notice: GROQ_API_KEY not set. Primary LLM in use: SafeGeminiLLM (timeout: 10.5s)")
        adapter_timeout = 10.5

    llm_list.extend([gemini_primary, gemini_secondary])

    resilient_llm = llm.FallbackAdapter(
        llm=llm_list,
        attempt_timeout=adapter_timeout,
        max_retry_per_llm=1,
        retry_interval=0.1,
    )

    # 7. Initialize Cartesia Sonic TTS (Natural British Voice from CARTESIA_VOICE_ID env)
    cartesia_voice = os.environ["CARTESIA_VOICE_ID"]
    active_tts = cartesia.TTS(
        model="sonic-3",
        voice=cartesia_voice,
        api_key=os.environ.get("CARTESIA_API_KEY"),
    )
    # Deepgram TTS fallback kept for reference:
    # active_tts = deepgram.TTS(model="aura-asteria-en")

    session = agents.AgentSession(
        vad=vad_model,
        stt=stt_instance,
        llm=resilient_llm,
        tts=active_tts,
        tts_text_transforms=[
            text_transforms.filter_markdown,
            text_transforms.filter_emoji,
            custom_speech_cleaner,
        ],
        turn_handling={
            "turn_detection": turn_detector_instance,
            "endpointing": {
                "mode": "dynamic",
                "min_delay": 0.4,
                "max_delay": 3.0,
            },
            "interruption": {
                "enabled": True,
                "mode": "vad",
                "min_duration": 0.5,
                "min_words": 1,
                "resume_false_interruption": True,
            },
            "preemptive_generation": {
                "enabled": True,
            },
        },
        aec_warmup_duration=0.0,
        use_tts_aligned_transcript=False,
        user_away_timeout=8.0,
    )

    # Metrics collection tracker (EOU delay | LLM TTFT | TTS TTFB | LLM provider)
    current_turn_metrics = {"eou_delay": None, "llm_ttft": None, "tts_ttfb": None, "llm_provider": None}

    @session.on("metrics_collected")
    def on_metrics_collected(ev):
        try:
            m = getattr(ev, "metrics", ev)
            m_type = getattr(m, "type", "")
            if m_type == "eou":
                current_turn_metrics["eou_delay"] = getattr(m, "end_of_utterance_delay", None)
            elif m_type == "llm":
                current_turn_metrics["llm_ttft"] = getattr(m, "ttft", None)
                label = getattr(m, "label", "") or ""
                if "groq" in label.lower():
                    current_turn_metrics["llm_provider"] = "Groq"
                elif "google" in label.lower() or "gemini" in label.lower():
                    current_turn_metrics["llm_provider"] = "Gemini"
                else:
                    current_turn_metrics["llm_provider"] = label or "Unknown"
            elif m_type == "tts":
                current_turn_metrics["tts_ttfb"] = getattr(m, "ttfb", None)
                # When TTS completes, print full turn summary line
                eou_str = f"{current_turn_metrics['eou_delay']*1000:.0f}ms" if current_turn_metrics['eou_delay'] is not None else "N/A"
                ttft_str = f"{current_turn_metrics['llm_ttft']*1000:.0f}ms" if current_turn_metrics['llm_ttft'] is not None else "N/A"
                ttfb_str = f"{current_turn_metrics['tts_ttfb']*1000:.0f}ms" if current_turn_metrics['tts_ttfb'] is not None else "N/A"
                provider_str = current_turn_metrics['llm_provider'] or ("Groq" if groq_api_key else "Gemini")
                print(f"[TURN METRICS] EOU delay: {eou_str} | LLM TTFT: {ttft_str} | TTS TTFB: {ttfb_str} | LLM: {provider_str}")
                # Reset turn metrics for next turn
                current_turn_metrics.update({"eou_delay": None, "llm_ttft": None, "tts_ttfb": None, "llm_provider": None})
        except Exception as ex:
            print(f"[*] Notice in metrics_collected: {ex}")

    # Calculate UK business hour greeting
    try:
        uk_hour = (datetime.now(timezone.utc) + timedelta(hours=1)).hour
    except Exception:
        uk_hour = 11
    time_greeting = "Good morning" if uk_hour < 12 else "Good afternoon"

    # State tracking for Smart Greeting & Instant Intro
    greeting_spoken = False
    intro_spoken = False
    greeting_lock = asyncio.Lock()
    timer_task = None

    async def speak_greeting(reason="timeout"):
        nonlocal greeting_spoken
        async with greeting_lock:
            if greeting_spoken:
                return
            greeting_spoken = True
            if direction == "OUTBOUND":
                greeting = f"{time_greeting}! Am I speaking with {lead_name}?"
            else:
                greeting = "Hello! Thank you for calling Inspire London College, my name is Sonia. Who do I have the pleasure of speaking with today?"
            print(f"[*] Speaking initial greeting ({reason}): '{greeting}'")
            try:
                await session.say(greeting, allow_interruptions=True)
                print(f"[*] Initial greeting finished speaking successfully.")
            except Exception as e:
                print(f"[!] Error speaking greeting: {e}")

    async def initial_greeting_timer():
        await asyncio.sleep(0.35)
        if not greeting_spoken:
            await speak_greeting(reason="instant_greeting")

    # 7. Real-Time Event Listeners for transcripts & state updates
    @session.on("user_input_transcribed")
    def on_user_input(ev):
        text = getattr(ev, "transcript", "").strip()
        if getattr(ev, "is_final", False) and text:
            print(f"[Deepgram STT Final]: {text}")
            # If caller speaks first (says "Hello" or anything), immediately trigger greeting!
            if not greeting_spoken:
                if timer_task and not timer_task.done():
                    timer_task.cancel()
                asyncio.create_task(speak_greeting(reason="caller_spoke_first"))

    # Proactive Contextual Follow-up when Caller goes silent during conversation
    @session.on("user_state_changed")
    def on_user_state_changed(ev):
        if ev.new_state == "away" and greeting_spoken and getattr(session, "agent_state", "") != "speaking":
            print("[*] Caller silent for 8s -> Proactively checking in...")
            session.generate_reply(
                instructions="Warmly check if the caller is still on the line: 'Hello, are you still there?'"
            )

    @session.on("conversation_item_added")
    def on_conversation_item_added(ev):
        role = getattr(ev.item, "role", "unknown")
        text = getattr(ev.item, "text_content", None) or getattr(ev.item, "content", None)
        if text:
            print(f"[{role.upper()}]: {text}")
            asyncio.create_task(orchestrator.log_transcript(role, text))

        # Enforce sliding conversation window (max 8 items) to ensure millisecond LLM speed
        try:
            if hasattr(session, "history") and session.history:
                session.history.truncate(max_items=8)
        except Exception as e:
            print(f"[*] History truncate notice: {e}")

    # 8. Disconnect handlers (detect when caller hangs up or room closes)
    disconnect_event = asyncio.Event()

    @ctx.room.on("participant_disconnected")
    def on_participant_disconnected(p):
        print(f"[*] Caller disconnected from room: {p.identity}")
        disconnect_event.set()

    @ctx.room.on("disconnected")
    def on_disconnected(reason):
        print(f"[*] Room disconnected: {reason}")
        disconnect_event.set()

    # 9. Start session with dynamic instructions and action tools
    if direction == "OUTBOUND":
        active_instructions = build_outbound_instructions(
            lead_name=lead_name,
            course_inquired=course_inquired
        )
        active_tools = [
            transfer_to_support_team,
            schedule_callback,
            mark_lead_disposition,
            search_website
        ]
    else:
        active_instructions = INBOUND_SYSTEM_INSTRUCTIONS
        active_tools = [
            search_website,
            check_student_enrollment,
            transfer_to_support_team,
            schedule_callback
        ]

    await session.start(
        room=ctx.room,
        agent=agents.Agent(
            instructions=active_instructions,
            tools=active_tools
        ),
        record={"audio": True, "traces": False}
    )

    # 10. Start initial greeting timer (Dual trigger: triggers on caller 'Hello' OR 2.5s silence)
    timer_task = asyncio.create_task(initial_greeting_timer())

    # 11. Keep entrypoint coroutine active until the call finishes
    await disconnect_event.wait()

    if timer_task and not timer_task.done():
        timer_task.cancel()

    # 12. Gracefully close agent session to flush all audio recordings to disk
    try:
        await session.aclose()
        # Brief pause to ensure Windows file system flushes encoder stream to disk
        await asyncio.sleep(0.35)
    except Exception as e:
        print(f"[*] Notice during session aclose: {e}")

    # 13. Locate recorded audio and upload to PostgreSQL database & dashboard storage
    try:
        session_dir = ctx.session_directory
        audio_files = list(session_dir.glob("*.ogg")) + list(session_dir.glob("*.wav")) + list(session_dir.rglob("*.ogg"))
        if not audio_files:
            # Fallback: check TEMP directory for recently created audio.ogg within last 5 minutes
            import tempfile, glob
            recent_ogg = sorted(
                glob.glob(os.path.join(tempfile.gettempdir(), "*", "audio.ogg")),
                key=os.path.getmtime,
                reverse=True
            )
            if recent_ogg and (time.time() - os.path.getmtime(recent_ogg[0])) < 300:
                audio_files = [recent_ogg[0]]

        if audio_files:
            recording_path = str(audio_files[0])
            size_kb = round(os.path.getsize(recording_path) / 1024, 1)
            print(f"[*] Call audio recording ready: {recording_path} ({size_kb} KB)")
            await orchestrator.save_recording(recording_path)
        else:
            print(f"[*] No audio recording found in session directory: {session_dir}")
    except Exception as e:
        print(f"[*] Error saving call audio recording: {e}")

    # 14. Finalize database call duration, AI summary, and recording URL (single unified record)
    await orchestrator.end_call(final_status="ANSWERED")

def prewarm(proc: agents.JobProcess):
    """Preload VAD and heavy modules into RAM so process starts immediately with zero delay."""
    proc.userdata["vad"] = silero.VAD.load(min_silence_duration=0.30, min_speech_duration=0.08, activation_threshold=0.55)
    try:
        import google.genai  # noqa: F401
        import huggingface_hub  # noqa: F401
    except Exception:
        pass

if __name__ == "__main__":
    _startup_groq_key = os.getenv("GROQ_API_KEY")
    print(f"[*] GROQ key loaded: {bool(_startup_groq_key)}")
    if _startup_groq_key:
        print("[*] Primary LLM in use: Groq (openai/gpt-oss-20b, timeout: 3.0s)")
    else:
        print("[*] Notice: GROQ_API_KEY not set. Primary LLM in use: SafeGeminiLLM (timeout: 10.5s)")
    cli.run_app(
        WorkerOptions(
            entrypoint_fnc=entrypoint,
            prewarm_fnc=prewarm,
            load_threshold=float("inf"),
            agent_name="voice-agent",
            num_idle_processes=3,
            initialize_process_timeout=30.0,
        )
    )