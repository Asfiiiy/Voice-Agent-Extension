_NOISE_QUERY_WORDS = {
    "payment", "plan", "plans", "details", "detail", "initial", "deposit", "fee", "fees",
    "cost", "price", "pricing", "installment", "installments", "instalment", "instalments",
    "monthly", "month", "months", "options", "option", "breakdown", "tuition", "full",
    "discounted", "regular", "about", "for", "the", "in", "of", "and", "what", "is", "are",
    "how", "much", "can", "you", "tell", "me", "course", "courses", "qualification",
    "qualifications", "inspire", "london", "college", "ilc", "ukpd", "schedule", "syllabus",
    "modules", "units", "duration", "entry", "requirements", "requirement", "assessment",
    "exams", "exam", "certificate", "accreditation",
}

def fuzzy_match_course(query: str):
    """Strips noise words like 'payment plan' or 'initial deposit' and fuzzy-matches against VERIFIED_COURSES_CATALOG."""
    q_low = (query or "").lower()
    # Extract explicit level if present
    lvl_match = re.search(r'\blevel\s*([1-7])\b|\bl([1-7])\b', q_low)
    query_level = (lvl_match.group(1) or lvl_match.group(2)) if lvl_match else None

    # Clean punctuation and strip noise words
    cleaned_tokens = [
        t for t in re.findall(r'[a-z0-9]+', q_low)
        if t not in _NOISE_QUERY_WORDS and not re.match(r'^[1-7]$', t) and t != "level"
    ]
    cleaned_str = " ".join(cleaned_tokens)

    best_score = 0.0
    best_course = None

    for c in VERIFIED_COURSES_CATALOG:
        score = 0.0
        title_low = c["title"].lower()
        title_tokens = {
            t for t in re.findall(r'[a-z0-9]+', title_low)
            if t not in _NOISE_QUERY_WORDS and not re.match(r'^[1-7]$', t) and t != "level"
        }

        # Check distinctive keyword matches
        for kw in c["keywords"]:
            if re.search(rf'\b{re.escape(kw)}\b', q_low) or (len(kw) > 4 and kw in q_low):
                score += 0.55
                break

        # Token overlap between cleaned query tokens and course title/keyword tokens
        if cleaned_tokens:
            all_course_tokens = set(title_tokens)
            for kw in c["keywords"]:
                all_course_tokens.update(re.findall(r'[a-z0-9]+', kw))
            overlap = sum(1 for t in cleaned_tokens if t in all_course_tokens)
            score += 0.45 * (overlap / len(cleaned_tokens))

        # Level matching bonus / penalty
        if query_level:
            if c["level"] == query_level:
                score += 0.30
            else:
                score -= 0.25

        if score > best_score:
            best_score = score
            best_course = c

    return best_score, best_course

def format_matched_course(course: dict) -> str:
    """Formats a single matched course's facts concisely. Omits all prices if pricing_status is UNVERIFIED."""
    if course.get("pricing_status") != "VERIFIED":
        return (
            f"Course Facts for {course['title']}:\n"
            f"- Pricing Status: UNVERIFIED / NOT_SURE (Exact tuition fee, initial deposit, and monthly instalment amounts are NOT confirmed on screen right now. Do NOT state or guess any prices, fees, deposits, or monthly figures. Offer to have a Senior Admissions Advisor call back or transfer to confirm the official fee schedule.)\n"
            f"- Duration & Study Mode: {course['duration']}\n"
            f"- Assessment: {course['assessment']}\n"
            f"- Accreditation: {course['accreditation']}\n"
            f"- Core Units: {course['modules']}"
        )
    return (
        f"Verified Course Facts for {course['title']}:\n"
        f"- Pricing Status: VERIFIED\n"
        f"- Tuition Fee: {course['fee']}\n"
        f"- Initial Deposit: {course['deposit']}\n"
        f"- Official Instalment Plan: {course['instalments']}\n"
        f"- Duration & Study Mode: {course['duration']}\n"
        f"- Assessment: {course['assessment']}\n"
        f"- Accreditation: {course['accreditation']}\n"
        f"- Core Units: {course['modules']}\n"
        f"IMPORTANT: State ONLY the fee, deposit, and instalment plan listed above. If asked for any other payment plan (e.g. a 6-month plan not listed above), say that specific plan is not listed on screen and offer to have a Senior Admissions Advisor confirm."
    )

async def get_live_site_data(query: str) -> str:
    """
    Main function called by AI Voice Agent (Sonia) to get 100% accurate, up-to-date answers
    from the full WordPress website (Courses, Modules, Pages, Policies, and Updates).
    """
    raw_q = query.strip()
    normalized_q = raw_q.lower()
    if not normalized_q:
        return "Please ask a specific course, qualification, or website policy question."

    # 1. Check RAM Cache
    cached = _cache.get(normalized_q)
    now = time.time()
    if cached and (now - cached["timestamp"]) < CACHE_TTL_SEC:
        return cached["result"]

    # 2. Check for CPD Video Training Questions (128 Courses across 3 suites)
    is_video_query = any(vk in normalized_q for vk in ["video training", "video course", "cpd video", "videotile"]) or ("video" in normalized_q and any(k in normalized_q for k in ["course", "offer", "how many", "cpd", "training", "module", "list", "sector", "suite"]))
    if is_video_query:
        res = await asyncio.to_thread(get_video_training_data, normalized_q)
        _cache[normalized_q] = {"timestamp": now, "result": res}
        return res

    # 2b. Check single-course fuzzy match first so course-level VERIFIED/UNVERIFIED gating is always enforced
    is_plural_overview = any(w in normalized_q for w in ["how many", "what courses", "which levels", "all qualifications", "list of courses"])
    if not is_plural_overview:
        f_score, f_course = fuzzy_match_course(raw_q)
        if f_score >= 0.45 and f_course:
            res = format_matched_course(f_course)
            _cache[normalized_q] = {"timestamp": now, "result": res}
            return res

    # 3. Check for Awarding Body Inquiries
    awarding_body_keywords = ["awarding body", "awarding bodies", "who regulates", "who accredits", "accredited bodies", "ofqual bodies", "awarding organisation", "awarding organization", "who awards", "which awarding"]
    if any(k in normalized_q for k in awarding_body_keywords) and not any(k in normalized_q for k in ["fee", "deposit", "installment"]):
        res = (
            "Approved UK Awarding Bodies at Inspire London College (Ofqual Regulated):\n"
            "Inspire London College is an accredited UK centre offering qualifications regulated by Ofqual (Office of Qualifications and Examinations Regulation) through 5 prestigious UK Awarding Organisations:\n"
            "1. Qualifi Ltd.: UK regulated awarding organisation specializing in Cyber Security (Levels 2 to 5), Health & Social Care (Levels 2 to 7), Business Management (Levels 3 to 7), Early Years Education, and Teacher Training (AET, CET, DET).\n"
            "2. OTHM Qualifications: Renowned Ofqual-regulated awarding body offering Information Technology (Level 3), Strategic Marketing (Level 7), Project Management (Level 7), Risk Management (Level 7), International Business Law (Level 7), Accounting & Finance (Levels 3, 5, 7), Logistics & Supply Chain (Levels 5 & 7), and Business Management.\n"
            "3. Focus Awards: Leading UK awarding organisation offering the popular Level 3 Award in Education and Training (AET), Level 3 Certificate in Assessing Vocational Achievement (CAVA), and Level 3 Emergency First Aid at Work.\n"
            "4. NOCN (National Open College Network): Regulated awarding body offering Adult Care, Dementia Care, Safe Handling of Medicines, Learning Disabilities, Education & Training, and Assessor qualifications.\n"
            "5. iCQ (iCQ Awards): Regulated awarding organisation offering Early Years Practitioner, Adult Social Care Certificates, Dementia Care, End of Life Care, and Education & Training.\n\n"
            "Regulatory Guarantee: All diplomas awarded by these awarding bodies are officially placed on the UK Regulated Qualifications Framework (RQF) and recognized by UK and international universities and employers for career advancement and degree top-ups."
        )
        _cache[normalized_q] = {"timestamp": now, "result": res}
        return res

    # 4. Check for High-Level Institutional Questions
    general_queries = [
        "how many qualification", "what qualification", "how many course", "what courses do you offer",
        "which levels do you offer", "what levels", "qualification levels", "all qualifications",
        "list of courses", "courses available", "programs available", "what do you offer",
        "regulating qualification", "regulated qualification", "ofqual regulated"
    ]
    specific_subject_keywords = ["cyber", "phlebotomy", "safety", "social care", "teaching", "education", "business", "accounting", "finance", "assessor", "cava", "aet", "det"]
    has_specific_subject = any(s in normalized_q for s in specific_subject_keywords)
    if any(g in normalized_q for g in general_queries) and not has_specific_subject:
        res = (
            "Inspire London College and UK Professional Development Academy offer over 290+ accredited qualifications across Levels 1 through 7, including undergraduate and postgraduate Master's degree pathways.\n\n"
            "Key Qualification Levels Offered:\n"
            "• Level 1 & 2: Foundational certificates (Healthcare, Business, Safety).\n"
            "• Level 3: Foundation Diplomas, including the OTHM Level 3 Foundation Diploma in Information Technology, Focus Awards Level 3 AET (£248 discounted fee), and Level 3 Phlebotomy Training (£80 Part 1 / £270 Part 2).\n"
            "• Level 4 & 5: Undergraduate equivalent Higher National Diplomas (Health & Social Care, Business Management, HR, Accounting).\n"
            "• Level 6 & 7: Bachelor's degree top-ups and Postgraduate Master's / MBA level qualifications (e.g. Level 7 Strategic Management & Leadership).\n\n"
            "Regulated Awarding Bodies: OTHM Qualifications, Qualifi, Focus Awards, NOCN, and iCQ (all regulated by Ofqual). 100% online study with dedicated tutor support."
        )
        _cache[normalized_q] = {"timestamp": now, "result": res}
        return res

    # 4b. Category Overviews (with UNVERIFIED price gating — no unverified fee schedules spoken)
    is_cyber_query = "cyber" in normalized_q or "cybersecurity" in normalized_q or "cyber security" in normalized_q
    if is_cyber_query:
        res = (
            "Cyber Security Suite Overview (Qualifi Ofqual-Regulated Levels 2 to 5):\n"
            "1. Qualifi Level 2 Diploma in Business Beginners in Cyber Security\n"
            "2. Qualifi Level 3 Diploma in Cyber Security Management and Operations\n"
            "3. Qualifi Level 4 Diploma in Cyber Security\n"
            "4. Qualifi Level 5 Diploma in Cyber Security\n"
            "5. Qualifi Level 5 Extended Diploma in Cyber Security\n"
            "• Delivery & Assessment: 100% online self-paced distance learning (6 to 12 months), 100% coursework assignments, zero exams.\n"
            "• Pricing Status: UNVERIFIED / NOT_SURE (Do NOT state any fee, deposit, or monthly instalment numbers. Offer a Senior Admissions Advisor callback to confirm the exact fee schedule.)"
        )
        _cache[normalized_q] = {"timestamp": now, "result": res}
        return res

    is_teacher_query = any(k in normalized_q for k in ["education and training", "teacher training", "teaching course", "teaching qualification", "aet", "det", "cet", "award in education", "diploma in education"])
    if is_teacher_query:
        res = (
            "Education & Training Qualifications (Ofqual Regulated):\n"
            "1. Focus Awards Level 3 Award in Education and Training (AET) [Pricing Status: VERIFIED]: Discounted fee £248 (regular £330), or £128 deposit + 2 monthly instalments of £60/month. Duration: 1-3 months online, zero exams.\n"
            "2. Qualifi Level 4 Certificate in Education and Training (CET) [Pricing Status: UNVERIFIED / NOT_SURE — do NOT quote prices, offer advisor callback].\n"
            "3. Qualifi Level 5 Diploma in Education and Training (DET) [Pricing Status: UNVERIFIED / NOT_SURE — do NOT quote prices, offer advisor callback].\n"
            "4. Qualifi Level 7 Diploma in Educational Management and Leadership [Pricing Status: UNVERIFIED / NOT_SURE — do NOT quote prices, offer advisor callback]."
        )
        _cache[normalized_q] = {"timestamp": now, "result": res}
        return res

    # 17. Smart Query Expansion (e.g. "IT" -> "Information Technology")
    expanded_search = expand_query(normalized_q)

    # 4. Check if corporate training, policy, or institutional page
    page_keywords = ["corporate", "staff training", "workforce", "policy", "refund", "terms", "about", "contact", "progression", "affiliate", "cancel"]
    is_page_query = any(k in normalized_q for k in page_keywords) and not any(k in normalized_q for k in ["diploma", "module", "unit", "credit", "fee", "dates", "requirement", "level", "course", "qualification"])

    chunks = []

    if is_page_query:
        db_pages = await asyncio.to_thread(search_db_pages, expanded_search)
        if db_pages:
            chunks.append("Official Website Pages & Corporate Information:")
            for p in db_pages[:2]:
                chunks.append(f"• {p['title']}: {p['content']}")
        else:
            pages = await search_wp_pages(expanded_search)
            if pages:
                chunks.append("Official Website Pages & Policies:")
                for p in pages[:2]:
                    chunks.append(f"• {p['title']}: {p['content']}")
    else:
        # 5. Search Database Courses with Exact Modules, Duration, & Fees
        courses = await asyncio.to_thread(search_db_courses, expanded_search)
        if courses:
            chunks.append("Live Course & Qualification Catalog (Direct from College Database):")
            is_plural = any(w in normalized_q for w in ["courses", "qualifications", "diplomas", "what", "which", "all", "list", "options", "offer", "any"])
            display_courses = courses[:3] if is_plural else courses[:1]
            for c in display_courses:
                if "Notice:" in c['name']:
                    chunks.append(f"• {c['name']}:\n  {c['requirements']}")
                    continue

                entry = [f"• Qualification: {c['name']}"]
                if c.get('accreditation'):
                    entry.append(f"  - Awarding Body: {c['accreditation']}")
                if c.get('price') and c['price'] != "N/A":
                    entry.append(f"  - Tuition Fee & Payment: {c['price']}")
                if c.get("payment_plans"):
                    entry.append("  - Official Installment Plans: " + "; ".join(c["payment_plans"]))
                if c.get("duration") and c['duration'] != "N/A":
                    entry.append(f"  - Duration: {c['duration']}")
                if c.get("modules"):
                    entry.append(f"  - Units: {', '.join(c['modules'][:6])}")
                if c.get("assessment"):
                    entry.append(f"  - Assessment: {c['assessment']}")
                chunks.append("\n".join(entry))
        else:
            # Fuzzy-match against verified built-in course catalog before checking pages
            score, matched_course = fuzzy_match_course(query)
            if score >= 0.40 and matched_course:
                chunks.append(format_matched_course(matched_course))
            else:
                db_pages = await asyncio.to_thread(search_db_pages, expanded_search)
                if db_pages:
                    chunks.append("Official Website Pages & Corporate Information:")
                    for p in db_pages[:2]:
                        chunks.append(f"• {p['title']}: {p['content']}")

    if not chunks:
        # Check for explicitly excluded non-offered subjects (Medicine, ACCA, Law LLB, Trades)
        alt_mappings = [
            (["doctor", "mbbs", "medicine", "nursing", "nurse", "paramedic", "dentist", "dentistry", "pharmacist"],
             "Notice: Inspire London College does not offer clinical degrees in Medicine, MBBS, or Nursing. Related accredited options: Level 3 Certificate in Phlebotomy (£80 Part 1 / £270 Part 2) and Qualifi/OTHM Level 3-5 Health and Social Care Diplomas."),
            (["acca", "cima", "chartered accountancy", "chartered accountant"],
             "Notice: Inspire London College does not offer ACCA or CIMA. Related Ofqual options: OTHM Level 3, Level 5, and Level 7 Diplomas in Accounting and Finance."),
            (["llb", "barrister", "solicitor"],
             "Notice: Inspire London College does not offer an LLB degree, but offers the OTHM Level 7 Diploma in International Business Law."),
            (["plumbing", "electrician", "carpentry", "mechanic", "welding"],
             "Notice: Inspire London College does not offer plumbing or electrical trade apprenticeships, but offers Level 1 Health and Safety in Construction (CSCS Green Card)."),
        ]

        matched_alt = None
        for keywords, alt_msg in alt_mappings:
            if any(re.search(rf'\b{re.escape(k)}\b', normalized_q) for k in keywords):
                matched_alt = alt_msg
                break

        if matched_alt:
            result_text = matched_alt
        else:
            # Try lower-threshold fuzzy match before declaring uncertain
            score, matched_course = fuzzy_match_course(query)
            if score >= 0.25 and matched_course:
                result_text = format_matched_course(matched_course)
            else:
                result_text = (
                    f"NOT_SURE: Exact details for '{query}' are not confirmed on screen right now. "
                    f"Do NOT state that we do not offer it and do NOT invent fees or payment plans. "
                    f"Politely tell the caller you want to make sure they get the exact official figures and offer to have a Senior Admissions Advisor confirm or schedule a quick callback."
                )
    else:
        result_text = "\n\n".join(chunks)

    # Cache result
    _cache[normalized_q] = {
        "timestamp": now,
        "result": result_text
    }

    return result_text

async def check_student_order_status(email_or_order_number: str) -> str:
    """
    Called when a student asks about their enrollment, order status, or payment.
    """
    clean_query = email_or_order_number.strip()
    if not clean_query:
        return "Please provide your registered email address or 5-digit Order Number to check your enrollment."

    orders = await search_wp_orders(clean_query)
    if not orders:
        return f"No active order or enrollment found matching '{clean_query}'. Please verify your details."

    results = []
    for o in orders:
        msg = (
            f"Order #{o['order_id']} for {o['customer_name']}: "
            f"Course: '{o['courses']}'. "
            f"Current Status: {o['status'].upper()}. "
            f"Order Date: {o['date']}."
        )
        if o['status'].lower() in ["completed", "processing"]:
            msg += " Your enrollment is active and verified."
        results.append(msg)

    return "\n".join(results)

