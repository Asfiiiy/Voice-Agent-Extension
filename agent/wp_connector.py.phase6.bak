                        else:
                            fee_str = "£12.00"
                        clean_b_short = re.sub(r'(Approved by|Duration:|Course Fee:).*', '', clean_b).strip()
                        specific_matches.append(
                            f"• Video Course: {c_title}\n"
                            f"  - Overview: {clean_b_short[:220]}...\n"
                            f"  - Duration: {dur}\n"
                            f"  - Tuition Fee: {fee_str} (Interactive VideoTile module)\n"
                            f"  - Certification: CPD Certified"
                        )
            if specific_matches:
                return "Matching CPD Video Training Courses:\n" + "\n\n".join(specific_matches[:2])

        # High-level institutional response for Video Training (128 courses)
        return (
            "Inspire London College offers 128 one-on-one tutor-led interactive CPD Video Training courses across 3 core sectors:\n"
            "1. Health & Safety Video Courses: 54 courses (RoSPA, CPD, and IIRSM approved; includes Fire Safety, Manual Handling, Asbestos Awareness, Working at Height, and CSCS Green Card preparation).\n"
            "2. Business Skills Video Courses: 41 courses (CPD certified; includes Leadership, Project Management, Negotiation, Customer Service, and AI in Business).\n"
            "3. Health & Social Care Video Courses: 33 courses (CPD certified; includes The Care Certificate, Autism Awareness, Dementia Awareness, Infection Control, and Safeguarding).\n\n"
            "Delivery, Pricing & Accreditation Details:\n"
            "• Platform: Interactive VideoTile e-learning platform featuring 1-on-1 tutor video guidance and interactive quizzes.\n"
            "• Study Mode & Duration: 100% online self-paced learning, typically 30 to 100 minutes per course with 24/7 access.\n"
            "• Pricing: Special promotional fees starting from just £12.00 per course (regular £350).\n"
            "• Certification: Immediate CPD accredited digital certificates upon completion.\n"
            "• Free Trial: A free trial is available so learners can test the interactive video module before enrolling."
        )
    except Exception as e:
        print(f"[WP-Connector] Video courses query error: {repr(e)}")
        return (
            "Inspire London College offers 128 interactive CPD Video Training courses across Health & Safety (54 courses), "
            "Business Skills (41 courses), and Health & Social Care (33 courses) on the VideoTile platform with CPD certification "
            "and promotional prices starting from £12.00."
        )

def search_db_courses(search_term: str) -> List[Dict[str, Any]]:
    """Direct high-speed database query to get 100% accurate courses, exact modules, duration, fees, and requirements across all 624 courses."""
    if not _check_mysql_available():
        return []
    try:
        conn = pymysql.connect(
            host=DB_HOST,
            user=DB_USER,
            password=DB_PASS,
            database=DB_NAME,
            charset='utf8mb4',
            connect_timeout=3
        )
        with conn.cursor(pymysql.cursors.DictCursor) as cur:
            q_clean = search_term.strip().lower()

            # Special Regulatory Notice: Level 3 Health & Safety does not exist at Inspire London College
            is_l3 = bool(re.search(r'\b(level\s*3|l3)\b', q_clean))
            is_hs = bool(re.search(r'\b(h\s*&\s*s|h\s+and\s+s|health\s*(&|and)\s*safety)\b', q_clean))
            if is_l3 and is_hs:
                conn.close()
                return [{
                    "name": "Notice: Level 3 Health and Safety is NOT offered by Inspire London College",
                    "price": "N/A",
                    "duration": "N/A",
                    "modules": [],
                    "dates": [],
                    "requirements": (
                        "Inspire London College does NOT offer a 'Level 3 Health and Safety' diploma. "
                        "The accredited Health & Safety qualifications offered are: "
                        "• Level 1 Health and Safety in a Construction Environment (Leading to CSCS Green Card) - Entry requirement: Aged 16 or above. "
                        "• Level 4 Extended Diploma in Health and Safety - Entry requirement: Aged 16 or above. "
                        "• Level 5 Diploma in Health and Safety at Work - Entry requirement: Aged 16 or above. "
                        "• Level 7 Extended Diploma in Health and Safety - Entry requirement: Aged 16 or above. "
                        "If you are seeking a Level 3 Healthcare qualification, we offer: "
                        "• Qualifi - Level 3 Diploma in Health and Social Care: Entry requirement: The learner must be aged 18 or above (with Level 2 qualification or relevant work experience). "
                        "• OTHM - Level 3 Foundation Diploma in Health and Social Care: Entry requirement: Aged 16 or above."
                    ),
                    "assessment": "Coursework assignments",
                    "suitable_for": "Learners seeking accredited Health & Safety or Health & Social Care qualifications.",
                    "accreditation": "Ofqual Regulated Awarding Bodies (OTHM and Qualifi)",
                    "certificate": "Verifiable PDF included; optional hard copy £30 + shipping.",
                    "overview": "Notice regarding available Health & Safety levels and Level 3 Health & Social Care alternatives."
                }]

            level_match = re.search(r'\blevel\s*([0-9])\b|\bl([0-9])\b', q_clean)
            target_level = f"Level {level_match.group(1) or level_match.group(2)}" if level_match else None

            # Fetch published courses excluding auxiliary checkout variations and bundles
            cur.execute("""
                SELECT ID, post_title, post_excerpt
                FROM twh_posts
                WHERE post_type = 'product' AND post_status = 'publish'
                  AND post_title NOT LIKE '%Bundle%'
                  AND post_title NOT LIKE '%(Full Fee)%'
                  AND post_title NOT LIKE '%Installment%'
                  AND post_title NOT LIKE '%(Fast Track)%'
                  AND post_title NOT LIKE '%(Initial Deposit)%'
                  AND post_title NOT LIKE '%Payment Link%'
                  AND post_title NOT LIKE '%Registration Fee%'
                  AND post_title NOT LIKE '%Reprint%'
                  AND post_title NOT LIKE '%Badge%'
            """)
            all_prods = cur.fetchall()

            stop_words = {
                'what', 'are', 'the', 'requirements', 'of', 'for', 'course', 'courses', 'diploma',
                'training', 'program', 'programs', 'certificate', 'certification',
                'tell', 'me', 'about', 'fee', 'fees', 'cost', 'duration', 'modules', 'units', 'online', 'uk',
                'can', 'could', 'would', 'will', 'do', 'does', 'did', 'is', 'am', 'was', 'were',
                'be', 'been', 'being', 'have', 'has', 'had', 'having', 'i', 'you', 'he', 'she', 'it', 'we', 'they',
                'my', 'your', 'his', 'her', 'our', 'their', 'a', 'an', 'and', 'or', 'but', 'if', 'so',
                'in', 'on', 'at', 'to', 'from', 'by', 'with', 'into', 'through', 'over', 'after',
                'become', 'want', 'need', 'like', 'get', 'taking', 'study', 'studying', 'learn', 'learning',
                'offer', 'offering', 'available', 'how', 'much', 'many', 'any', 'some', 'there', 'please'
            }
            tokens = [w for w in re.split(r'\W+', q_clean) if len(w) > 1 and w not in stop_words]

            scored = []
            for p in all_prods:
                title = p['post_title']
                tl = title.lower()
                title_words = set(re.split(r'\W+', tl))
                score = 0

                # Exact phrase match
                if q_clean in tl:
                    score += 150

                # Level matching
                if target_level:
                    if target_level.lower() in tl:
                        score += 100
                    elif any(f'level {i}' in tl for i in range(1, 9)):
                        score -= 150  # Conflicting level penalty

                # Subject mutual exclusivity: Safety vs Social Care
                if 'safety' in q_clean and ('social' in tl or 'care' in tl):
                    score -= 120
                if ('social' in q_clean or 'care' in q_clean) and 'safety' in tl:
                    score -= 120

                # Token matching with whole words
                matched = 0
                for t in tokens:
                    if t in title_words:
                        matched += 1
                        score += 50
                        if t in ['phlebotomy', 'safety', 'social', 'care', 'technology', 'management', 'accounting', 'education']:
                            score += 60

                if len(tokens) > 0 and matched == len(tokens):
                    score += 150  # All query tokens matched!

                # CRITICAL: If query tokens exist and none matched, and exact query not in title, do not match!
                if tokens and matched == 0 and (q_clean not in tl):
                    continue

                # Awarding body mutual exclusivity and boosting
                awarding_bodies = ['focus', 'qualifi', 'othm', 'nocn', 'icq', 'athe']
                explicit_ab = None
                for ab in awarding_bodies:
                    if ab in q_clean:
                        explicit_ab = ab
                        break

                if explicit_ab:
                    # If caller explicitly asked for this awarding body:
                    if explicit_ab in tl:
                        score += 300  # Massive priority boost for requested awarding body
                    else:
                        # Severely penalize courses from competing awarding bodies
                        if any(other in tl for other in awarding_bodies if other != explicit_ab):
                            score -= 500
                else:
                    # General boost for any recognized Ofqual regulated awarding body ONLY IF course matched topic
                    if any(ab in tl for ab in awarding_bodies) and (matched > 0 or q_clean in tl):
                        score += 30

                # Demote CPD / Professional Development if seeking formal qualification
                if ('cpd' in tl or 'professional development' in tl) and 'cpd' not in q_clean:
                    score -= 150

                if score > 0:
                    scored.append((score, p))

            scored.sort(key=lambda x: x[0], reverse=True)
            top_prods = [p for s, p in scored[:3]]

            if not top_prods:
                conn.close()
                return []

            # Fetch detailed metadata for top matched courses
            courses = []
            for p in top_prods:
                pid = p['ID']
                title = p['post_title']
                cur.execute("""
                    SELECT meta_key, meta_value FROM twh_postmeta
                    WHERE post_id = %s AND meta_key IN (
                        'course_outline', 'requirements', 'whoisthisfor', 'course-assessment', 'assessment_method',
                        'course-accreditation', 'awarding_body', 'course-certification', 'certificate',
                        '_price', '_regular_price', 'installment_text', 'duration', 'course-duration',
                        'study_method', 'faq_5_description', 'payment_options'
                    )
                """, (pid,))
                meta_dict = {m['meta_key']: m['meta_value'] for m in cur.fetchall()}

                price = meta_dict.get('_price') or "N/A"
                reg_price = meta_dict.get('_regular_price')
                installment = meta_dict.get('installment_text')
                price_str = f"£{price}" if price != "N/A" else "N/A"
                if reg_price and reg_price != price:
                    price_str += f" (Regular: £{reg_price})"

                # Parse all installment options (6, 8, 10 months, fast-track)
                payment_plans = _parse_payment_options(meta_dict.get('payment_options') or "")
                if payment_plans:
                    plan_summary = "; ".join([p for p in payment_plans if "plan" in p.lower() or "month" in p.lower()])
                    if plan_summary:
                        price_str += f" | Installment Plans: {plan_summary}"
                elif installment:
                    price_str += f" | Installments: {installment}"

                raw_dur = _clean_html(meta_dict.get('duration') or meta_dict.get('course-duration') or "") or "6 months - 12 months"
                study_mode = _clean_html(meta_dict.get('study_method') or "") or "Flexible self-paced distance learning"
                duration_str = f"{raw_dur} ({study_mode})"

                modules = _parse_modules_table(meta_dict.get('course_outline') or "")
                
                req = _clean_html(meta_dict.get('requirements') or "")
                if not req:
                    req = "No formal academic prerequisites; good understanding of English and ICT skills required."
                elif len(req) > 400:
                    req = req[:400] + "..."

                ass = _clean_html(meta_dict.get('course-assessment') or meta_dict.get('assessment_method') or "")
                who = _clean_html(meta_dict.get('whoisthisfor') or "")
                acc = _clean_html(meta_dict.get('course-accreditation') or meta_dict.get('awarding_body') or "")
                if not acc or len(acc) < 3:
                    tl = title.lower()
                    if "qualifi" in tl:
                        acc = "Qualifi Ltd. (Regulated by Ofqual, UK)"
                    elif "othm" in tl:
                        acc = "OTHM Qualifications (Regulated by Ofqual, UK)"
                    elif "focus" in tl:
                        acc = "Focus Awards (Regulated by Ofqual, UK)"
                    elif "nocn" in tl:
                        acc = "NOCN (Regulated by Ofqual, UK)"
                    elif "icq" in tl:
                        acc = "iCQ Awards (Regulated by Ofqual, UK)"
                    elif "athe" in tl:
                        acc = "ATHE (Regulated by Ofqual, UK)"
                    elif "tquk" in tl:
                        acc = "TQUK (Regulated by Ofqual, UK)"
                    elif "phlebotomy" in tl:
                        acc = "CPD Standards Office & Accredited UK Healthcare Training"
                    else:
                        acc = "Ofqual Regulated Awarding Organisation"
                cert = _clean_html(meta_dict.get('course-certification') or meta_dict.get('certificate') or "")
                if not cert:
                    cert = "Verifiable digital PDF certificate and transcript is issued free of charge (included in the course fee). Optional official hard copy can be ordered from the awarding body portal for £30 plus shipping."

                dates = []
                if "phlebotomy" in title.lower():
                    dates = ["22 August 2026 (Saturday)", "05 September 2026 (Saturday)", "19 September 2026 (Saturday)", "10 October 2026 (Saturday)"]

                courses.append({
                    "name": title,
                    "price": price_str,
                    "payment_plans": payment_plans,
                    "duration": duration_str,
                    "modules": modules,
                    "dates": dates,
                    "requirements": req,
                    "assessment": ass[:250] if ass else "100% assignment-based coursework, no written examinations.",
                    "suitable_for": who[:250] if who else "",
                    "accreditation": acc[:250] if acc else "",
                    "certificate": cert,
                    "overview": _clean_html(p.get('post_excerpt') or "")[:200]
                })

            conn.close()
            return courses
    except Exception as e:
        print(f"[WP-Connector] DB Search exception: {repr(e)}")
        return []

STOPWORDS_COURSE = {
    'level', 'diploma', 'certificate', 'award', 'extended', 'foundation',
    'single', 'subject', 'course', 'courses', 'training', 'in', 'and', 'of',
    'for', 'the', 'a', 'an', 'online', 'programme', 'qualification', 'qualifications'
}

SYNONYMS_COURSE = {
    'it': ['information technology', 'computing'],
    'ict': ['information technology', 'computing'],
    'cyber': ['cyber security', 'cybersecurity'],
    'cyber security': ['cyber security', 'cybersecurity'],
    'health and social care': ['health and social care', 'social care', 'health social'],
    'hsc': ['health and social care'],
    'h&s': ['health and safety'],
    'hr': ['human resource', 'human resource management'],
    'hrm': ['human resource management'],
    'aet': ['education and training', 'aet'],
    'det': ['diploma in education and training', 'education and training', 'det'],
    'cava': ['assessing vocational achievement', 'cava'],
}

def clean_course_tokens(text: str) -> List[str]:
    tokens = re.findall(r'[a-z0-9]+', text.lower())
    return [t for t in tokens if t not in STOPWORDS_COURSE]

def score_course_match(query: str, title: str) -> float:
    q_low = query.strip().lower()
    t_low = title.strip().lower()

    if q_low == t_low:
        return 1.0

    if len(q_low) > 3 and re.search(rf'\b{re.escape(q_low)}\b', t_low):
        seq = difflib.SequenceMatcher(None, q_low, t_low).ratio()
        return max(0.85, seq)

    q_toks = set(clean_course_tokens(query))
    t_toks = set(clean_course_tokens(title))

    q_levels = set(re.findall(r'\b(?:level|l)\s*([1-8])\b', q_low))
    t_levels = set(re.findall(r'\b(?:level|l)\s*([1-8])\b', t_low))
    if q_levels and t_levels and not (q_levels & t_levels):
        return 0.0

    expanded_q_toks = set(q_toks)
    for k, syns in SYNONYMS_COURSE.items():
        if k == q_low or k in q_toks:
            for s in syns:
                expanded_q_toks.update(clean_course_tokens(s))

    subject_q_toks = {t for t in expanded_q_toks if not t.isdigit()}
    subject_t_toks = {t for t in t_toks if not t.isdigit()}

    if subject_q_toks:
        subj_overlap = subject_q_toks & subject_t_toks
        if not subj_overlap:
            return 0.0
        subj_recall = len(subj_overlap) / len(subject_q_toks)
    else:
        subj_recall = 0.5

    seq = difflib.SequenceMatcher(None, q_low, t_low).ratio()
    return (subj_recall * 0.7) + (seq * 0.3)

def search_courses_db(keyword_or_category: str, limit: int = 5) -> List[Dict[str, Any]]:
    """Returns up to limit REAL published courses from the DB (title, level, awarding body) using WordPress product category first and whole-word regex."""
    if not _check_mysql_available():
        return []
    try:
        conn = get_db_connection()
        p = WP_TABLE_PREFIX
        q_low = keyword_or_category.strip().lower()

        # Category search terms
        cat_terms = [q_low]
        if q_low in ('it', 'tech', 'computing'):
            cat_terms = ['information-technology', 'information technology', 'computing']
        elif 'health' in q_low or 'social care' in q_low:
            cat_terms = ['health-and-social-care', 'health-social-care', 'health & social care', 'health and social care']
        elif 'cyber' in q_low:
            cat_terms = ['cyber-security', 'cyber security']
        elif 'business' in q_low or 'management' in q_low:
            cat_terms = ['business-management', 'business management']
        elif 'accounting' in q_low or 'finance' in q_low:
            cat_terms = ['accounting-finance', 'accounting and finance', 'accounting & finance']

        with conn.cursor() as cur:
            cur.execute(f"""
                SELECT DISTINCT tr.object_id, t.name as cat_name, t.slug as cat_slug
                FROM {p}term_relationships tr
                JOIN {p}term_taxonomy tt ON tr.term_taxonomy_id = tt.term_taxonomy_id
                JOIN {p}terms t ON tt.term_id = t.term_id
                WHERE tt.taxonomy = 'product_cat'
            """)
            cat_rows = cur.fetchall()

        cat_matched_ids = {}
        for r in cat_rows:
            cn = html.unescape(r['cat_name']).lower()
            cs = r['cat_slug'].lower()
            for ct in cat_terms:
                if ct in cn or ct in cs or (ct == 'it' and ('information-technology' in cs or 'information technology' in cn)):
                    cat_matched_ids[r['object_id']] = cn

        with conn.cursor() as cur:
            cur.execute(f"SELECT ID, post_title FROM {p}posts WHERE post_type='product' AND post_status='publish'")
            all_courses = cur.fetchall()

        # Whole-word title match terms
        title_terms = [q_low]
        if q_low == 'it':
            title_terms = ['it', 'information technology', 'computing', 'computer systems', 'computer science']
        elif 'health' in q_low or 'social care' in q_low:
            title_terms = ['health and social care', 'health & social care', 'social care']
        elif 'cyber' in q_low:
            title_terms = ['cyber security', 'cyber']

        excluded_words = ['bundle', 'reprint', 'badge', 'payment link', 'initial deposit', 'fast track', 'full fee', 'installments', 'instalment']

        results = []
        seen_titles = set()
        for c in all_courses:
            pid = c['ID']
            title = html.unescape(c['post_title'])
            t_low = title.lower()

            if any(w in t_low for w in excluded_words):
                continue

            in_cat = pid in cat_matched_ids
            title_matched = False
            for term in title_terms:
                if len(term) <= 3:
                    # STRICT whole-word boundary for short terms like 'it'
                    if re.search(r'\b' + re.escape(term) + r'\b', t_low, re.IGNORECASE):
                        title_matched = True
                        break
                else:
                    if term in t_low:
                        title_matched = True
                        break

            if in_cat or title_matched:
                with conn.cursor() as cur:
                    cur.execute(f"SELECT meta_key, meta_value FROM {p}postmeta WHERE post_id=%s AND meta_key IN ('course_level', 'awarding_body')", (pid,))
                    meta = {r['meta_key']: r['meta_value'] for r in cur.fetchall()}

                ab = meta.get('awarding_body')
                lvl = meta.get('course_level')
                if not ab:
                    if 'othm' in t_low: ab = 'OTHM Qualifications'
                    elif 'qualifi' in t_low: ab = 'Qualifi Ltd.'
                    elif 'focus' in t_low: ab = 'Focus Awards'
                    elif 'nocn' in t_low: ab = 'NOCN'
                    elif 'icq' in t_low: ab = 'iCQ Awards'
                    else: ab = 'Inspire London College'
                if not lvl:
                    l_m = re.search(r'level\s*([0-9])', t_low)
                    lvl = f"Level {l_m.group(1)}" if l_m else "Professional Qualification"

                clean_title = title.replace('&amp;', '&').replace('–', '-').strip()
                if clean_title not in seen_titles:
                    seen_titles.add(clean_title)
                    combined_text = f"{(ab or '').lower()} {t_low}"
                    is_regulated = bool(re.search(r'\b(othm|qualifi|focus awards|nocn|icq|ofqual|rqf|nvq)\b', combined_text))
                    is_cpd = 'professional development' in t_low or 'cpd' in t_low
                    direct_title_match = any(t in t_low for t in ['health and social care', 'health & social care']) if 'health' in q_low else (q_low in t_low)

                    if direct_title_match and is_regulated and not is_cpd:
                        priority = 0
                    elif is_regulated and in_cat and not is_cpd:
                        priority = 1
                    elif is_regulated and not is_cpd:
                        priority = 2
                    elif in_cat and not is_cpd:
                        priority = 3
                    else:
                        priority = 4

                    results.append({
                        'title': clean_title,
                        'level': lvl,
                        'awarding_body': ab,
                        '_priority': priority
                    })

        conn.close()
        results.sort(key=lambda x: (x['_priority'], x['title']))
        clean_res = [{'title': r['title'], 'level': r['level'], 'awarding_body': r['awarding_body']} for r in results[:limit]]
        return clean_res
    except Exception as e:
        print(f"[WP-Connector] Error in search_courses_db: {e}")
        return []

def get_course_details_from_db(query: str, threshold: float = 0.50) -> Dict[str, Any]:
    """Fetches exact verified course facts directly from MySQL WordPress/WooCommerce DB with score threshold."""
    if not query:
        return {"status": "NOT_FOUND", "message": "No course query provided.", "closest_courses": []}
    q_norm = query.strip().lower()
    if q_norm in _DB_COURSE_CACHE:
        return _DB_COURSE_CACHE[q_norm]

    if not _check_mysql_available():
        return {"status": "NOT_FOUND", "message": "Database not currently available.", "closest_courses": []}

    try:
        conn = get_db_connection()
        p = WP_TABLE_PREFIX
        posts_tbl = f"{p}posts"
        meta_tbl = f"{p}postmeta"

        with conn.cursor() as cur:
            cur.execute(f"SELECT ID, post_title FROM {posts_tbl} WHERE post_type='product' AND post_status='publish'")
            all_courses = cur.fetchall()

        if not all_courses:
            conn.close()
            return {"status": "NOT_FOUND", "message": "No published courses found in database.", "closest_courses": []}

        scored = []
        for c in all_courses:
            title = c['post_title']
            t_low = title.lower()
            if any(w in t_low for w in ['bundle', 'reprint', 'badge', 'payment link', 'initial deposit', 'fast track', 'full fee']):
                continue
            sc = score_course_match(query, title)
            scored.append((sc, c))

        scored.sort(key=lambda x: x[0], reverse=True)
        best_score, best_course = scored[0] if scored else (0.0, None)
        matched_title = best_course['post_title'] if best_course else 'None'
        print(f"[get_course_info] Query: '{query}' | Matched: '{matched_title}' | Score: {best_score:.3f} | Threshold: {threshold}")

        if best_score < threshold or not best_course:
            closest = [c['post_title'] for sc, c in scored[:3] if sc > 0.05]
            conn.close()
            res = {
                "status": "NOT_FOUND",
                "message": f"Course '{query}' was not found in our catalogue.",
                "closest_courses": closest or [c['post_title'] for _, c in scored[:3]]
            }
            _DB_COURSE_CACHE[q_norm] = res
            return res

        pid = best_course['ID']
        title = best_course['post_title']

        with conn.cursor() as cur:
            cur.execute(f"SELECT meta_key, meta_value FROM {meta_tbl} WHERE post_id=%s", (pid,))
            meta = {r['meta_key']: r['meta_value'] for r in cur.fetchall()}

            cur.execute(f"SELECT ID, post_title FROM {posts_tbl} WHERE post_parent=%s AND post_type='product_variation'", (pid,))
            vars_rows = cur.fetchall()
            var_data = []
            for v in vars_rows:
                cur.execute(f"SELECT meta_key, meta_value FROM {meta_tbl} WHERE post_id=%s", (v['ID'],))
                var_data.append({**v, 'meta': {r['meta_key']: r['meta_value'] for r in cur.fetchall()}})

        conn.close()

        def clean(val):
            if not val:
                return None
            t = re.sub(r'<[^>]+>', ' ', str(val))
            t = re.sub(r'\s+', ' ', t).strip()
            return t if t else None

        # Parse units
        units = []
        outline = meta.get('course_outline')
        if outline:
            rows = re.findall(r'<tr[^>]*>(.*?)</tr>', outline, flags=re.DOTALL | re.IGNORECASE)
            for r in rows:
                cells = re.findall(r'<td[^>]*>(.*?)</td>', r, flags=re.DOTALL | re.IGNORECASE)
                cell_texts = [clean(c) for c in cells if clean(c)]
                if len(cell_texts) >= 2:
                    for ct in cell_texts:
                        ct_low = ct.lower()
                        if ct and not re.match(r'^[A-Z0-9\/]+$', ct) and not ct.isdigit() and ct_low not in (
                            'mandatory units', 'elective units', 'unit reference', 'level', 'credit', 'tqt', 'glh',
                            'unit ref. no.', 'unit title', 'unit reference no'
                        ):
                            if ct not in units:
                                units.append(ct)
            if not units:
                lis = re.findall(r'<li[^>]*>(.*?)</li>', outline, flags=re.DOTALL | re.IGNORECASE)
                for li in lis:
                    c_li = clean(li)
                    if c_li and len(c_li) > 5 and not c_li.startswith('http'):
                        units.append(c_li)

        reg_fee = None
        sale_price = None
        deposit = None
        monthly_amount = None
        months = None

        for vd in var_data:
            m = vd['meta']
            mode = (m.get('attribute_payment-mode') or '').lower()
            rp = m.get('_regular_price')
            sp = m.get('_sale_price') or m.get('_price')
            if rp and not reg_fee:
                reg_fee = f"£{rp}"
            if 'full' in mode:
                if sp:
                    sale_price = f"£{sp}"
            elif 'instal' in mode or 'month' in mode:
                if sp and not deposit:
                    deposit = f"£{sp}"
                m_cnt = re.search(r'([0-9]+)\s*months?', mode)
                if m_cnt and not months:
                    months = int(m_cnt.group(1))

        if not reg_fee and meta.get('_regular_price'):
            reg_fee = f"£{meta.get('_regular_price')}"
        if not sale_price and meta.get('_price'):
            sale_price = f"£{meta.get('_price')}"
        if not deposit and meta.get('minimum_price'):
            deposit = f"£{meta.get('minimum_price')}"

        inst_text = meta.get('installment_text') or ''
        m_match = re.search(r'£?([0-9]+(?:\.[0-9]+)?)\s*(?:per month|a month|\/month)', inst_text, re.IGNORECASE)
        if m_match:
            monthly_amount = f"£{m_match.group(1)}"
        m_mo = re.search(r'for\s*([0-9]+)\s*months?', inst_text, re.IGNORECASE)
        if m_mo:
            months = int(m_mo.group(1))

        cert = clean(meta.get('course-certification') or meta.get('certificate'))
        awarding_body = clean(meta.get('awarding_body'))
        if not awarding_body:
            tl = title.lower()
            if 'othm' in tl: awarding_body = 'OTHM Qualifications'
            elif 'qualifi' in tl: awarding_body = 'Qualifi Ltd.'
            elif 'focus' in tl: awarding_body = 'Focus Awards'
            elif 'nocn' in tl: awarding_body = 'NOCN'
            else: awarding_body = 'Inspire London College'

        level = clean(meta.get('course_level'))
        if not level:
            l_m = re.search(r'level\s*([0-9])', title.lower())
            level = f"Level {l_m.group(1)}" if l_m else "Professional Qualification"

        duration = clean(meta.get('duration') or meta.get('course-duration'))
        assessment = clean(meta.get('assessment_method') or meta.get('course-assessment'))
        entry_req = clean(meta.get('requirements'))

        course_record = {
            "status": "FOUND",
            "title": title,
            "fee": reg_fee or None,
            "sale_price": sale_price or None,
            "deposit": deposit or None,
            "monthly_amount": monthly_amount or None,
            "months": months or None,
            "duration": duration or None,
            "awarding_body": awarding_body or None,
            "level": level or None,
            "assessment": assessment or None,
            "certificate": cert or None,
            "entry_requirements": entry_req or None,
            "units": units or None
        }
        _DB_COURSE_CACHE[q_norm] = course_record
        return course_record
    except Exception as e:
        print(f"[WP-Connector] Error in get_course_details_from_db: {e}")
        return {"status": "NOT_FOUND", "message": f"Error querying database: {e}", "closest_courses": []}

async def search_wp_pages(query: str) -> List[Dict[str, str]]:
    """Searches website pages (About Us, Policies, Accreditations, Admission guidelines)."""
    url = f"{WP_URL}/wp-json/wp/v2/pages?search={urllib.parse.quote_plus(query)}&per_page=3&_fields=id,title,excerpt"
    try:
        timeout = httpx.Timeout(2.5, connect=1.0)
        async with httpx.AsyncClient(timeout=timeout, auth=AUTH) as client:
            resp = await client.get(url, headers=HEADERS)
            if resp.status_code == 200:
                raw_pages = resp.json()
                pages = []
                for p in raw_pages:
                    title = _clean_html(p.get("title", {}).get("rendered", ""))
                    excerpt = _clean_html(p.get("excerpt", {}).get("rendered", ""))
                    if title and excerpt:
                        pages.append({"title": title, "content": excerpt})
                return pages
    except Exception as e:
        print(f"[WP-Connector] Page search error: {repr(e)}")
    return []

async def search_wp_orders(query: str) -> List[Dict[str, Any]]:
    """Looks up student order and enrollment status by email or order number."""
    clean_q = query.strip()
    is_direct_id = clean_q.isdigit()

    if is_direct_id:
        url = f"{WP_URL}/wp-json/wc/v3/orders/{clean_q}"
    else:
        url = f"{WP_URL}/wp-json/wc/v3/orders?search={urllib.parse.quote_plus(clean_q)}&per_page=2"

    try:
        timeout = httpx.Timeout(18.0, connect=5.0)
        async with httpx.AsyncClient(timeout=timeout, auth=AUTH) as client:
            resp = await client.get(url, headers=HEADERS)
            if resp.status_code == 200:
                data = resp.json()
                raw_orders = [data] if is_direct_id and isinstance(data, dict) else (data if isinstance(data, list) else [])
                orders = []
                for o in raw_orders:
                    order_id = o.get("id")
                    status = o.get("status", "unknown")
                    billing = o.get("billing", {})
                    first_name = billing.get("first_name", "")
                    last_name = billing.get("last_name", "")
                    customer_name = f"{first_name} {last_name}".strip() or "Valued Student"
                    items = [it.get("name", "") for it in o.get("line_items", [])]
                    orders.append({
                        "order_id": order_id,
                        "status": status,
                        "customer_name": customer_name,
                        "courses": ", ".join(items),
                        "total": f"£{o.get('total', '0.00')}",
                        "date": o.get("date_created", "")[:10]
                    })
                return orders
    except Exception as e:
        print(f"[WP-Connector] Order lookup error: {repr(e)}")
    return []

