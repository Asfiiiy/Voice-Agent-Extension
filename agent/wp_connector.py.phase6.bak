                f"• Popular Courses: Basic Fire Safety Awareness, Manual Handling, Asbestos Awareness, Working at Height, COSHH, Level 1 H&S in Construction (CSCS Green Card route), Food Safety Level 1 & 2, and DSE Awareness.\n"
                f"• Delivery & Duration: 1-on-1 tutor-led interactive online video on VideoTile, 30 to 100 minutes per course, self-paced with 24/7 access.\n"
                f"• Tuition Fee: Special promotional price starting at £12.00 per course (regular £350).\n"
                f"• Free Trial: Available online before purchasing."
            )
        elif any(k in q_lower for k in ["health and social care", "health & social care", "social care"]):
            title, slug, content = pages.get(15476, ("", "", ""))
            links = re.findall(r'<a[^>]*>(.*?)</a>', content)
            courses = [re.sub(r'<[^>]+>', '', l).strip() for l in links if l.strip() and not any(k in l.lower() for k in ['login', 'see courses', 'http', 'localhost'])]
            return (
                f"Health & Social Care Video Courses Suite (33 interactive courses):\n"
                f"• Accreditation: CPD certified.\n"
                f"• Popular Courses: The Care Certificate, Autism Awareness, Dementia Awareness, Infection Control, Safeguarding Adults, Safeguarding Children, Mental Health Awareness, Dignity & Privacy, and Diabetes Awareness.\n"
                f"• Delivery & Duration: 1-on-1 tutor-led interactive online video on VideoTile, 30 to 60 minutes per course, self-paced with 24/7 access.\n"
                f"• Tuition Fee: Special promotional price starting at £12.00 per course (regular £350).\n"
                f"• Free Trial: Available online before purchasing."
            )
        elif any(k in q_lower for k in ["business skills", "business skill"]):
            title, slug, content = pages.get(15469, ("", "", ""))
            links = re.findall(r'<a[^>]*>(.*?)</a>', content)
            courses = [re.sub(r'<[^>]+>', '', l).strip() for l in links if l.strip() and not any(k in l.lower() for k in ['login', 'see courses', 'http', 'localhost'])]
            return (
                f"Business Skills Video Courses Suite (41 interactive courses):\n"
                f"• Accreditation: CPD certified.\n"
                f"• Popular Courses: Leadership Skills, Project Management, Negotiation, Customer Service, Sales Skills, AI in Business, GDPR, Conflict Resolution, and Anti-Bribery.\n"
                f"• Delivery & Duration: 1-on-1 tutor-led interactive online video on VideoTile, self-paced with 24/7 access.\n"
                f"• Tuition Fee: Special promotional price starting at £12.00 per course (regular £350).\n"
                f"• Free Trial: Available online before purchasing."
            )

        # Check for specific course topic (e.g. autism, fire, asbestos, manual handling)
        distinct_words = [w for w in re.sub(r'[^a-z0-9\s]', ' ', q_lower).split() if len(w) > 2 and w not in ["video", "training", "course", "courses", "cpd", "tell", "about", "what", "how", "many", "offer", "you", "awareness", "skills", "care", "safety"]]
        if distinct_words:
            specific_matches = []
            for pid in [15458, 15469, 15476]:
                title, slug, content = pages.get(pid, ("", "", ""))
                blocks = re.findall(r'<h[234][^>]*>(.*?)</h[234]>(.*?)(?=<h[234]|$)', content, re.DOTALL)
                for h, body in blocks:
                    c_title = _clean_html(h)
                    t_lower = c_title.lower()
                    if any(dw in t_lower for dw in distinct_words):
                        clean_b = _clean_html(body)
                        dur_match = re.search(r'Duration:\s*([0-9]+\s*mins?)', clean_b, re.IGNORECASE)
