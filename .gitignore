# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Environment files - NEVER commit these
.env
.env.local
.env*.local
.env.agentname.bak
.env.inworld.bak
.env.phase2c.bak
agent/.env
agent/.env.*

# Python
.venv/
__pycache__/
*.pyc
agent/venv/

# Placeholder env files are safe to commit
!.env.example
!agent/.env.example
